---
/**
 * The Greenhouse index (P12): longer technical articles in roomy rows: title, summary,
 * date, the level and prerequisites where the author stated them, topic tags. A level is
 * never assumed.
 */
import { formatWhen } from "../../../editorial/model.ts"
import type { IndexItem } from "../../../editorial/model.ts"

interface Props {
  items: readonly IndexItem[]
  /** The heading, when it is not the ordinary one (the development demonstrations). */
  heading?: string
  /** A sentence under the heading. */
  intro?: string
  /** The heading's ID; unique when the page holds two indexes. */
  labelId?: string
}

const {
  items,
  heading = "Articles · newest first",
  intro,
  labelId = "ed-index-label",
} = Astro.props
---

<section class="ed-index ed-index--greenhouse" aria-labelledby={labelId} data-editorial-index="greenhouse">
  <h2 class="ed-index__label" id={labelId}>{heading}</h2>
  {intro && <p class="ed-index__intro">{intro}</p>}
  <ol class="ed-index__list">
    {
      items.map((item) => (
        <li>
          <h3 class="ed-index__title">
            <a href={item.path}>{item.title}</a>
          </h3>
          {item.description && <p class="ed-index__summary">{item.description}</p>}
          <p class="ed-index__meta">
            {item.when && <time datetime={item.when}>{formatWhen(item.when)}</time>}
            {item.details.difficulty && <span>Level: {item.details.difficulty}</span>}
            {item.details.tags.length > 0 && <span>{item.details.tags.join(" · ")}</span>}
            {item.status === "archived" && <span>Archived</span>}
          </p>
        </li>
      ))
    }
  </ol>
</section>
