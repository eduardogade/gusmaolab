---
/**
 * One editorial entry on its owning folder's paper (P10, D-080): title, description,
 * dates, and the Markdown body rendered by Astro. The minimum a Markdown entry needs to
 * read well; each collection's own reading layout belongs to P12.
 *
 * The page's folders come from FolderPage, which resolves the entry's URL to its owner,
 * so this component draws no folders, tabs or colours of its own: it uses the global
 * typography and the category's reading paper.
 *
 * The data-editorial-* attributes say what the page is. The smoke test reads them to
 * accept only entries that are published or archived.
 */
import { render } from "astro:content"
import type { CollectionEntry, CollectionKey } from "astro:content"
import { collectionById } from "../../editorial/collections.ts"
import type { CollectionId } from "../../editorial/collections.ts"
import { formatWhen } from "../../editorial/model.ts"
import type { CommonData } from "../../editorial/schema.ts"

interface Props {
  collection: CollectionId
  entry: CollectionEntry<CollectionKey>
}

const { collection, entry } = Astro.props
const data = entry.data as CommonData
const { Content } = await render(entry)
const period = typeof data.period === "string" ? data.period : undefined
---

<article
  class="gl-prose gl-article"
  data-editorial-collection={collection}
  data-editorial-status={data.status}
  data-editorial-slug={data.slug}
>
  <header class="gl-article__header">
    <p class="gl-article__overline">{collectionById(collection).label}</p>
    <h1>{data.title}</h1>
    {data.description && <p class="gl-article__description">{data.description}</p>}
    <p class="gl-article__meta">
      {period && <span>{formatWhen(period)}</span>}
      {
        data.publishedAt && (
          <span>
            Published <time datetime={data.publishedAt}>{formatWhen(data.publishedAt)}</time>
          </span>
        )
      }
      {
        data.updatedAt && (
          <span>
            Updated <time datetime={data.updatedAt}>{formatWhen(data.updatedAt)}</time>
          </span>
        )
      }
    </p>
    {
      data.status === "archived" && (
        <p class="gl-article__notice" role="note">
          Archived: this entry is kept for the record and may be out of date.
        </p>
      )
    }
    {
      data.status === "draft" && (
        <p class="gl-article__notice" role="note">
          Draft preview: this entry is not published, and a production build leaves it out.
        </p>
      )
    }
  </header>
  <div class="gl-article__body">
    <Content />
  </div>
</article>

<style>
  .gl-article__overline,
  .gl-article__meta,
  .gl-article__notice {
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--font-size-sm);
  }

  .gl-article__overline {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .gl-article__description {
    font-size: var(--font-size-lead);
    color: var(--color-text-secondary);
  }

  .gl-article__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-s);
  }

  .gl-article__notice {
    padding: var(--space-xs) var(--space-s);
    border-inline-start: var(--border-width-thick) solid var(--color-quote-rule);
    background-color: var(--color-surface-callout);
    color: var(--color-text-primary);
  }

  .gl-article__header > * + * {
    margin-block-start: var(--space-xs);
  }

  /* Rendered Markdown carries no classes, so its elements are styled from here. */
  .gl-article__body :global(h2),
  .gl-article__body :global(h3),
  .gl-article__body :global(h4) {
    margin-block-start: 1.5em;
  }

  .gl-article__body :global(img) {
    block-size: auto;
    max-inline-size: 100%;
  }

  .gl-article__body :global(pre),
  .gl-article__body :global(table) {
    max-inline-size: 100%;
    overflow-x: auto;
  }

  .gl-article__body :global(table) {
    display: block;
  }

  .gl-article__body :global(ul),
  .gl-article__body :global(ol) {
    padding-inline-start: 1.5em;
  }
</style>
