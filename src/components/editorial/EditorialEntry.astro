---
/**
 * One editorial entry (P12): renders its Markdown with Astro, finds what surrounds it (the
 * entries before and after it, its sequence, the entries the author related to it) and hands
 * both to the collection's own reading layout. The layout is picked by one explicit map
 * (src/layouts/editorial/layouts.ts), which tests/editorial-layouts.mjs checks against the
 * presentation table (src/editorial/reading.ts).
 *
 * The page's folders come from FolderPage, which resolves the entry's URL to its owner, so
 * this component draws no folders, tabs or colours of its own.
 *
 * A level-1 heading in the Markdown would be a second `<h1>`, since the title is the first:
 * it fails the build, naming the entry.
 *
 * A scientific entry (P13): when the manifest has a document for this entry, its body is the
 * article fragment that scripts/science.mjs made from a Quarto source, and its headings are
 * those of that fragment. The entry's own Markdown file holds only its metadata. Everything else
 * is unchanged: the same layout, the same routes, the same publication state.
 *
 * A demonstration (P13-A01, src/demos/) is the same component with the same layout; the only
 * difference is that it is read among the demonstrations and states that it is synthetic.
 */
import { render } from "astro:content"
import { collectionById } from "../../editorial/collections.ts"
import { scientificEntry } from "../../science/index.ts"
import type { CollectionEntry, CollectionKey } from "astro:content"
import type { CollectionId } from "../../editorial/collections.ts"
import type { CommonData } from "../../editorial/schema.ts"
import { readingContextFor } from "../../editorial/site.ts"
import { EDITORIAL_LAYOUTS } from "../../layouts/editorial/layouts.ts"

interface Props {
  collection: CollectionId
  entry: CollectionEntry<CollectionKey>
}

const { collection, entry } = Astro.props
const data = entry.data as CommonData
// A demonstration (P13-A01) is read from src/demos/; its scientific document is `demo/<name>`.
const demo = entry.collection === "greenhouseDemos"
const science = scientificEntry(demo ? "demo" : collectionById(collection).directory, entry.id)
const rendered = science === undefined ? await render(entry) : undefined
const headings = science?.headings ?? rendered!.headings
if (headings.some((heading) => heading.depth === 1)) {
  throw new Error(
    `${collection}/${entry.id}: the Markdown has a level-1 heading; the title is the page's <h1>, so sections start at ##`,
  )
}
const context = await readingContextFor(collection, entry.id, demo)
const Layout = EDITORIAL_LAYOUTS[collection]
// Quarto writes code blocks as plain <pre> elements that scroll sideways when a line is long, and tables that
// do the same (`.ed__body table` is a scrolling box, editorial.css). A scrolling region the keyboard cannot
// reach fails WCAG 2.1.1: axe-core found the <pre> case in P22, and the table case on the first GitHub run
// (P22-A01), where the runner's wider fallback font made a table overflow. Shiki's blocks already carry
// tabindex="0"; this gives every <pre> and <table> the same, in memory, without touching a generated article.
// It covers a Quarto article's HTML and the HTML Astro rendered from a Markdown entry (`entry.rendered.html`,
// the same string `<Content />` writes), so a wide table in plain Markdown is reachable too (D-160). The cost is
// one extra tab stop for a table that never scrolls: a static build cannot know the reader's fonts or width.
// A display equation (`<math display="block">`) is the third scrolling region: on a phone, or with enlarged text, a wide
// formula scrolls inside its own box (P23, D-161), and the box is the `<math>` itself, in Chrome and in Firefox.
const keyboardScrollable = (html: string): string =>
  html.replace(/<(?:pre|table)\b(?![^>]*\btabindex=)|<math\b(?=[^>]*\bdisplay="block")(?![^>]*\btabindex=)[^>]*>/g, (tag) =>
    tag.startsWith("<math") ? `${tag.slice(0, -1)} tabindex="0">` : `${tag} tabindex="0"`,
  )
const markdownHtml = rendered === undefined ? undefined : (entry as { rendered?: { html?: string } }).rendered?.html
---

<Layout collection={collection} data={data} context={context} headings={headings}>
  {
    science ? (
      <Fragment set:html={keyboardScrollable(science.html)} />
    ) : markdownHtml !== undefined ? (
      <Fragment set:html={keyboardScrollable(markdownHtml)} />
    ) : (
      rendered && <rendered.Content />
    )
  }
</Layout>
