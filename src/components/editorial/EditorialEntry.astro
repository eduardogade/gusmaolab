---
/**
 * One editorial entry (P12): renders its Markdown with Astro, finds what surrounds it (the
 * entries before and after it, its sequence, the entries the author related to it) and hands
 * both to the collection's own reading layout. The layout is picked by one explicit map
 * (src/layouts/editorial/layouts.ts), which tests/editorial-layouts.mjs checks against the
 * presentation table (src/editorial/reading.ts).
 *
 * The page's folders come from FolderPage, which resolves the entry's URL to its owner, so
 * this component draws no folders, tabs or colours of its own.
 *
 * A level-1 heading in the Markdown would be a second `<h1>`, since the title is the first:
 * it fails the build, naming the entry.
 */
import { render } from "astro:content"
import type { CollectionEntry, CollectionKey } from "astro:content"
import type { CollectionId } from "../../editorial/collections.ts"
import type { CommonData } from "../../editorial/schema.ts"
import { readingContextFor } from "../../editorial/site.ts"
import { EDITORIAL_LAYOUTS } from "../../layouts/editorial/layouts.ts"

interface Props {
  collection: CollectionId
  entry: CollectionEntry<CollectionKey>
}

const { collection, entry } = Astro.props
const data = entry.data as CommonData
const { Content, headings } = await render(entry)
if (headings.some((heading) => heading.depth === 1)) {
  throw new Error(
    `${collection}/${entry.id}: the Markdown has a level-1 heading; the title is the page's <h1>, so sections start at ##`,
  )
}
const context = await readingContextFor(collection, entry.id)
const Layout = EDITORIAL_LAYOUTS[collection]
---

<Layout collection={collection} data={data} context={context} headings={headings}>
  <Content />
</Layout>
