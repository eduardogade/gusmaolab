---
/**
 * The index of a collection's published and archived entries (P12, D-094): the collection's
 * own presentation of its entries, in its own order, or a plain statement that there are none
 * yet. Drafts never reach it. Each collection's index is a component of its own
 * (src/components/editorial/indexes/), chosen by one explicit map, and shares the shell's
 * stylesheet.
 */
import "../../styles/editorial.css"
import type { CollectionId } from "../../editorial/collections.ts"
import type { IndexItem } from "../../editorial/model.ts"
import { groupIndex, PRESENTATIONS } from "../../editorial/reading.ts"
import EditorialEmptyState from "./EditorialEmptyState.astro"
import BerriesIndex from "./indexes/BerriesIndex.astro"
import BlogIndex from "./indexes/BlogIndex.astro"
import BookClubIndex from "./indexes/BookClubIndex.astro"
import GreenhouseIndex from "./indexes/GreenhouseIndex.astro"
import KosmosIndex from "./indexes/KosmosIndex.astro"
import MonthsOriginalIndex from "./indexes/MonthsOriginalIndex.astro"
import TimberLogsIndex from "./indexes/TimberLogsIndex.astro"
import TrailIndex from "./indexes/TrailIndex.astro"

interface Props {
  collection: CollectionId
  items: readonly IndexItem[]
}

const { collection, items } = Astro.props
const groups = groupIndex(collection, items)
---

<div data-editorial-index-collection={collection}>
  {items.length === 0 && <EditorialEmptyState text={PRESENTATIONS[collection].emptyText} />}
  {items.length > 0 && collection === "blog" && <BlogIndex items={items} />}
  {items.length > 0 && collection === "trail" && <TrailIndex groups={groups} />}
  {items.length > 0 && collection === "greenhouse" && <GreenhouseIndex items={items} />}
  {items.length > 0 && collection === "berries" && <BerriesIndex items={items} />}
  {items.length > 0 && collection === "timberLogs" && <TimberLogsIndex groups={groups} />}
  {items.length > 0 && collection === "monthsOriginal" && <MonthsOriginalIndex groups={groups} />}
  {items.length > 0 && collection === "kosmos" && <KosmosIndex groups={groups} />}
  {items.length > 0 && collection === "bookClub" && <BookClubIndex groups={groups} />}
</div>
