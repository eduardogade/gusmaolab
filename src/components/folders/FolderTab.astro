---
/**
 * One physical index tab (P05). It shows a display tab's label; the selected tab also
 * carries the V indicator and joins its folder body (src/styles/folders.css).
 *
 * On site pages the label is a link to the tab's page (P06), and the whole tab is its
 * click target. The tab that stands for the page being shown has `aria-current="page"`;
 * every other selected tab is an open folder that contains the page, with
 * `aria-current="true"`. An Overview tab adds its parent's name for assistive technology:
 * "Overview of CV". Design studies draw labels without links.
 *
 * An unopened folder with children also carries its preview (P07): a hidden index card of
 * its contents, after the link, never inside it. The tab's link is unchanged by it.
 *
 * A top-level tab carries its section's archive category (P09-A01): its permanent
 * cardstock, whichever folder is open. Its preview, inside it, takes the same category.
 * Tabs below the first level belong to the open section and take the page's category.
 */
import type { DisplayTab, TabPreview } from "../../navigation/index.ts"
import FolderPreview from "./FolderPreview.astro"

interface Props {
  tab: DisplayTab
  selected?: boolean
  /** This tab stands for the page being shown. */
  current?: boolean
  /** Draw the label as a link to the tab's page. False only in design studies. */
  link?: boolean
  /** The folder's contents, for an unselected folder with children (P07). */
  preview?: TabPreview
}

const { tab, selected = false, current = false, link = true, preview } = Astro.props
const Label = link ? "a" : "span"
const ariaCurrent = link && current ? "page" : selected ? "true" : undefined
const category = tab.kind === "folder" && tab.node.level === 1 ? tab.node.category : undefined
---

<li
  class="gl-folder-tab"
  data-tab-id={tab.id}
  data-tab-kind={tab.kind}
  data-category={category}
  data-selected={selected ? "" : undefined}
  data-preview={preview ? "" : undefined}
>
  <span class="gl-folder-tab__shape" aria-hidden="true"></span>
  <Label class="gl-folder-tab__label" href={link ? tab.href : undefined} aria-current={ariaCurrent}>{tab.label}{tab.kind === "overview" && <span class="gl-visually-hidden"> of {tab.parent.label}</span>}</Label>
  {preview && <FolderPreview preview={preview} link={link} />}
  {
    selected && (
      <svg
        class="gl-folder-tab__indicator"
        viewBox="0 0 16 8"
        preserveAspectRatio="none"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M1.5 1.5 8 6.5 14.5 1.5" vector-effect="non-scaling-stroke" />
      </svg>
    )
  }
</li>
