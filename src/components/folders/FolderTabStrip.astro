---
/**
 * One row of physical tabs (P05): the global row of sections, or one open folder's
 * children led by its Overview tab, in registry order. Exactly one tab is selected. If the
 * row is wider than its folder it scrolls sideways on its own (src/styles/folders.css).
 *
 * On site pages the row is a navigation landmark named after its folder: "Sections",
 * "CV folders" (P06). Design studies draw a plain labelled list, because their tabs are
 * not links.
 */
import type { TabRow } from "../../navigation/index.ts"
import FolderTab from "./FolderTab.astro"

interface Props {
  row: TabRow
  /** Draw the tabs as links. */
  links: boolean
  /** The tab that stands for the page being shown, if it is in this row. */
  currentTabId: string | null
}

const { row, links, currentTabId } = Astro.props
const label = row.parent === null ? "Sections" : `${row.parent.label} folders`
const Strip = links ? "nav" : "div"
---

<Strip class="gl-folder__strip" aria-label={links ? label : undefined}>
  <ul class="gl-folder__tabs" role="list" aria-label={links ? undefined : label}>
    {
      row.tabs.map((tab) => (
        <FolderTab
          tab={tab}
          selected={tab.id === row.selectedId}
          current={tab.id === currentTabId}
          link={links}
          preview={row.previews.get(tab.id)}
        />
      ))
    }
  </ul>
</Strip>
