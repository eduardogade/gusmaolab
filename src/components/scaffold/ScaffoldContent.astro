---
/**
 * Temporary content for a folder page (P06): development scaffolding, labelled as such,
 * until the section's real content arrives in the content prompts (P10–P17). It names the
 * folder from the registry and invents nothing: no biography, research or achievements.
 *
 * It deliberately repeats none of the open folders' labels as a trail: the folders
 * themselves say where the page is, and the site has no breadcrumbs.
 */
import { siteNavigation } from "../../navigation/index.ts"

interface Props {
  /** The page's URL, as for FolderPage. */
  path: string
}

const result = siteNavigation.resolve(Astro.props.path)
if (!result.found || result.state.page.kind !== "folder") {
  throw new Error(`ScaffoldContent: ${Astro.props.path} is not a folder page`)
}
const folder = result.state.page.node
const count = folder.children.length
---

<div class="gl-prose scaffold" data-scaffold="p06">
  <p class="scaffold-overline">Development scaffolding · temporary page</p>
  <h1>{folder.label}</h1>
  <p>
    This page exists so that the folder navigation can be tried: each tab opens its own page,
    and the open folders follow the address. The content for {folder.label} has not been written
    yet; it arrives in a later prompt.
  </p>
  {
    count > 0 && (
      <p>
        This is the {folder.label} overview. {folder.label} holds {count} folders: the tabs after
        Overview.
      </p>
    )
  }
  <slot />
</div>

<style>
  .scaffold-overline {
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }
</style>
