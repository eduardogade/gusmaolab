---
/**
 * The 3D nucleus with a caption (P19, D-135): the frame (NucleusFrame.astro) in a figure, for the
 * specimen. The homepage stage uses the frame alone, with its own text. The caption says the picture
 * is provisional and steps aside once the 3D nucleus (or its still render) is on screen.
 */
import NucleusFrame from "./NucleusFrame.astro"

interface Props {
  /** The frame's accessible name. */
  label?: string
  /** Width over height of the frame. */
  ratio?: string
}

const { label, ratio } = Astro.props
---

<figure class="nucleus" data-nucleus-figure>
  <NucleusFrame label={label} ratio={ratio} />
  <figcaption class="nucleus__caption" data-nucleus-caption>
    A still picture of the model, provisional. The three-dimensional nucleus replaces it where the browser can show it.
  </figcaption>
</figure>

<style is:global>
  .nucleus {
    margin: 0;
    min-inline-size: 0;
  }

  .nucleus__caption {
    margin-block-start: var(--space-2xs);
    color: var(--color-text-muted);
    font-family: var(--font-label);
    font-size: var(--font-size-xs);
  }

  .nucleus__frame[data-nucleus-state="ready"] ~ .nucleus__caption,
  .nucleus__frame[data-nucleus-state="static"] ~ .nucleus__caption {
    display: none;
  }
</style>
