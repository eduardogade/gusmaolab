---
/**
 * The frame of the 3D nucleus (P19, D-135; shared by the homepage stage in P20, D-139): markup and
 * the frame's styles, no script and no 3D code. The element with `data-nucleus-frame` is what
 * `mountNucleus` (src/visualization/nucleus/) fills with a canvas; until then, and for good when 3D is
 * unavailable or JavaScript is off, it holds a still picture of the same model (fallback.ts: the
 * nucleus's own geometry projected to SVG paths, not another illustration). The frame keeps one
 * footprint in every state, so nothing moves when the canvas arrives (D-115's rule for the homepage
 * stage, kept here): either an aspect ratio of its own, or, with `fill`, the whole of the box its
 * parent gives it.
 *
 * The picture is provisional: a flat capture of the prototype, to be replaced by an approved one.
 * The frame is a single image to assistive technology: the canvas is hidden from it, and the label
 * says what is shown and that the model is illustrative.
 */
import { buildFallback } from "../../visualization/nucleus/fallback.ts"

interface Props {
  /** The frame's accessible name. */
  label?: string
  /** Width over height of the frame. Ignored with `fill`. */
  ratio?: string
  /** Fill the parent's box instead of keeping an aspect ratio of its own. */
  fill?: boolean
}

const {
  label = "An illustrative three-dimensional model of an interphase cell nucleus: a translucent envelope around folded chromatin, with one region highlighted in yellow.",
  ratio = "4 / 3",
  fill = false,
} = Astro.props
const picture = buildFallback()
---

<div
  class="nucleus__frame"
  data-nucleus-frame
  data-nucleus-state="picture"
  data-fill={fill ? "" : undefined}
  role="img"
  aria-label={label}
  style={fill ? undefined : `aspect-ratio: ${ratio}`}
>
  <svg class="nucleus__picture" viewBox={picture.viewBox} preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
    <path class="nucleus__envelope" d={picture.envelope}></path>
    {
      picture.paths.map((p) => (
        <path d={p.d} stroke={p.stroke} stroke-width={p.width} stroke-opacity={p.opacity}></path>
      ))
    }
  </svg>
</div>

<style is:global>
  .nucleus__frame {
    position: relative;
    inline-size: 100%;
    min-inline-size: 0;
    overflow: hidden;
  }

  .nucleus__frame[data-fill] {
    position: absolute;
    inset: 0;
    block-size: 100%;
  }

  .nucleus__picture {
    display: block;
    inline-size: 100%;
    block-size: 100%;
  }

  .nucleus__picture path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The picture's own colours are the object's, not the site's (D-131). */
  .nucleus__picture .nucleus__envelope {
    fill: #e6eef7;
    fill-opacity: 0.55;
    stroke: #b3c7e0;
    stroke-width: 1.6;
  }

  .nucleus__frame > canvas {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    display: block;
    /* The canvas never takes a pointer event: links and tabs under or beside it work as ever. */
    pointer-events: none;
    touch-action: auto;
  }

  /* Once the 3D nucleus (or its still render) is on screen, the picture steps aside. */
  .nucleus__frame[data-nucleus-state="ready"] .nucleus__picture,
  .nucleus__frame[data-nucleus-state="static"] .nucleus__picture {
    visibility: hidden;
  }
</style>
