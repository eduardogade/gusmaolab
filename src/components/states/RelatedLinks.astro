---
/**
 * A few folders that sit next to this one (P17, D-123): real destinations, named by registry ID, so
 * the label and URL are the registry's and a link can never point at a page that does not exist.
 * Never every section, and never a disabled card. Draws nothing for an empty list.
 */
import { siteNavigation } from "../../navigation/index.ts"

interface Props {
  /** Registry IDs of the related folders (at most three). */
  ids: readonly string[]
  /** The owning destination's ID, for a unique heading ID. */
  id: string
}

const { ids, id } = Astro.props
const links = ids.map((related) => {
  const node = siteNavigation.node(related)
  const parent = node.parentId === null ? undefined : siteNavigation.node(node.parentId)
  return { href: node.path, label: parent === undefined ? node.label : `${parent.label}: ${node.label}` }
})
const titleId = `related-${id}`
---

{
  links.length > 0 && (
    <section class="related" aria-labelledby={titleId} data-related>
      <h2 id={titleId} class="related__title">Related</h2>
      <ul class="related__list">
        {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
      </ul>
    </section>
  )
}
