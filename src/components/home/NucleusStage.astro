---
/**
 * Region B of the homepage (P15, D-115): the reserved stage for the interactive nucleus and
 * chromosome visualization. P15 builds the frame, not the model. Nothing here pretends to be the
 * visualization: no drawing of a nucleus, no moving part, no 3D code, and the label says it is
 * not built yet.
 *
 * The integration point is the `visual` slot of `.stage__frame`. A future milestone puts its
 * element there and sets `state` ("ready" once it runs, "loading" while it starts, "error" if
 * it fails); the frame keeps its footprint in every state, so the page never shifts, and the
 * text beside it is the fallback for anyone who cannot or does not use the model. The frame
 * knows nothing of any 3D library, and the welcome and the other regions do not know of it.
 *
 * A future interactive element must be keyboard operable, name itself, offer touch and pointer
 * equivalents, and stay still under `prefers-reduced-motion`; the frame sets aside no motion
 * of its own.
 */
interface Props {
  /** "placeholder" until a visualization exists. */
  state?: "placeholder" | "loading" | "ready" | "error"
}

const { state = "placeholder" } = Astro.props
const STATUS: Record<string, string> = {
  placeholder: "In development: not built yet",
  loading: "Loading the model",
  ready: "Interactive model",
  error: "The model could not be shown",
}
---

<section class="stage" aria-labelledby="stage-title" data-home-region="stage" data-stage-state={state}>
  <div class="stage__text">
    <h2 id="stage-title" class="home-heading">Inside the nucleus</h2>
    <p>
      Genomes are folded, not just read. A three-dimensional, interactive model of a nucleus and
      its chromosomes is planned for this space, so that the structure behind the sequence can be
      explored by turning it.
    </p>
    <p class="stage__status" data-stage-status>{STATUS[state]}</p>
  </div>
  <div class="stage__frame" role="group" aria-labelledby="stage-title" data-stage-frame>
    <slot name="visual">
      <p class="stage__placeholder" data-stage-placeholder>
        <span class="stage__badge">Reserved</span>
        The interactive nucleus will appear here. It does not exist yet, and nothing in this frame
        is a preview of it.
      </p>
    </slot>
  </div>
</section>
