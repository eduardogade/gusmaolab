---
/**
 * Region B of the homepage (P15, D-115; the nucleus mounted by P20, D-139): the stage of the 3D
 * nucleus. The footprint is P15's and unchanged: a frame of one aspect ratio (src/styles/home.css), so
 * the page never shifts whatever the frame holds. Inside it is the shared nucleus frame
 * (components/scientific/NucleusFrame.astro): a still picture of the same model in the static HTML,
 * which is all there is when JavaScript is off, WebGL is unavailable or the load fails, and which the
 * canvas replaces where it can draw.
 *
 * The script (src/scripts/home-nucleus.ts) is small and loads the graphics code only when the stage
 * is near the screen. It keeps `data-stage-state` and the status line in step with what is shown:
 * "picture" (static HTML), "loading", "ready" (interactive), "static" (a still nucleus: touch or
 * reduced motion) or "fallback" (3D was not possible). The welcome and the other regions do not know
 * of any of it.
 *
 * The text is honest about what this is: an illustration, not a measured genome.
 */
import NucleusFrame from "../scientific/NucleusFrame.astro"
---

<section
  class="stage"
  aria-labelledby="stage-title"
  data-home-region="stage"
  data-stage-state="picture"
  data-nucleus-stage
>
  <div class="stage__text">
    <h2 id="stage-title" class="home-heading">Inside the nucleus</h2>
    <p>
      Genomes are folded, not just read. This is an illustration of an interphase nucleus: a
      translucent envelope around folded chromatin, with one region highlighted in yellow.
    </p>
    <p>
      With a mouse or the keyboard, point at or focus a folder tab at the top of the page and the
      highlighted region opens a little toward it. It is an artistic model, not a measured genome
      or a simulation.
    </p>
    <p class="stage__status" data-stage-status>Still picture of the model</p>
  </div>
  <div class="stage__frame" role="group" aria-labelledby="stage-title" data-stage-frame>
    <NucleusFrame fill />
  </div>
</section>

<script>
  import "../../scripts/home-nucleus.ts"
</script>
