---
// Home (P15, D-112): the entrance to the archive, in the Home folder. Its regions are the
// components in src/components/home/; the recent Blog updates are the newest published entries
// of the real Blog (src/home/updates.ts), so while nothing is published the page says so.
// The development specimen, /_design/home/, draws these same components with synthetic entries.
import FolderPage from "../layouts/FolderPage.astro"
import HomePage from "../components/home/HomePage.astro"
import { demosEnabled } from "../editorial/demo.ts"
import { homeRecentUpdates } from "../editorial/site.ts"
import { HOME_SPECIMEN } from "../design/home-fixture.ts"
import { CLOCKS_SPECIMEN } from "../design/clocks-scenarios.ts"

const updates = await homeRecentUpdates()
---

<FolderPage
  title="GusmaoLab"
  description="GusmaoLab is a personal workshop for research, engineering, teaching and writing: computational biology, software, notes and stories, with Bearnard."
>
  <HomePage updates={updates} />
  {
    demosEnabled() && (
      <p class="home-specimen-link" data-home-specimen-link>
        Development only, not part of the website: <a href={HOME_SPECIMEN}>this page with example Blog posts</a>, <a href={CLOCKS_SPECIMEN}>the world clocks at simulated instants</a>;
        the older design studies, <a href="/_design/tokens/">design tokens</a> and <a href="/_design/folders/">physical folders</a>.
      </p>
    )
  }
</FolderPage>
