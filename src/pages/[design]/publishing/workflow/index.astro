---
// The development Publishing Workbench's workflow example (P14, D-110): the real commands run on a
// throwaway, synthetic article, with their real output. The transcript is generated by
// tests/fixtures/authoring/scenario.mjs and tests/authoring.mjs fails when it no longer matches
// what the commands print, so this page cannot describe commands that behave differently.
import FolderPage from "../../../../layouts/FolderPage.astro"
import WorkbenchBanner from "../../../../design/publishing/WorkbenchBanner.astro"
import { DRAFT_PAGE, WORKBENCH_ROOT } from "../../../../design/publishing/workbench.ts"
import { demosEnabled } from "../../../../editorial/demo.ts"
import transcript from "../../../../design/publishing/workflow-transcript.txt?raw"

export function getStaticPaths() {
  return demosEnabled() ? [{ params: { design: "_design" } }] : []
}

// The transcript is one block of text; each command and its output is shown as its own block.
const steps = transcript
  .trimEnd()
  .split(/\n\n(?=\$ |# )/)
  .map((block) => block.trimEnd())
---

<FolderPage path="/lecture-notes/greenhouse/" title="Workflow example (workbench) · GusmaoLab">
  <WorkbenchBanner current="workflow" />
  <div class="gl-prose" data-workbench-page="workflow">
    <h1>An Example of the GusmaoLab Publishing Workflow</h1>
    <p>
      This is a synthetic article, <em>A Small Example</em>, taken from its first draft to
      archive. Each block below is the real output of the real command, run on a throwaway copy of
      the project folder that was deleted afterwards. Nothing was written to the site's content, and
      nothing here was published.
    </p>
    <ol>
      <li><strong>Create.</strong> The draft starts with <code>status: draft</code>, no date, and a slug fixed from the title.</li>
      <li><strong>Check.</strong> Missing pieces are warnings while it is a draft.</li>
      <li><strong>Break it.</strong> A misspelt field is an error, with the way to fix it.</li>
      <li><strong>Repair and check again.</strong></li>
      <li><strong>Publish.</strong> First a dry run, which changes nothing; then the same command with <code>--yes</code>.</li>
      <li><strong>Archive.</strong> The status changes; the address and the date stay.</li>
    </ol>
    <p>
      While you write, <code>npm run dev</code> shows the draft at its address in the real folder; an
      <a href={DRAFT_PAGE}>example of a draft preview</a> is on this workbench. The expected address once
      published is the one the commands print:
      <code>/lecture-notes/greenhouse/a-small-example/</code>.
    </p>
  </div>
  <div class="steps" data-workbench-transcript>
    {
      steps.map((step) => (
        <pre tabindex="0"><code>{step}</code></pre>
      ))
    }
  </div>
  <div class="gl-prose">
    <h2>What was and was not shown</h2>
    <p>
      The commands changed one source file in a temporary folder. Committing, pushing and deploying
      are separate steps that none of them take. The preview step is not in the transcript because
      it depends on whether your dev server is running; the page above shows its result.
    </p>
    <p><a href={WORKBENCH_ROOT}>Back to the Publishing Workbench</a></p>
  </div>
</FolderPage>

<style>
  .steps {
    margin-block: var(--space-l);
    display: grid;
    gap: var(--space-s);
    max-inline-size: 60rem;
  }

  .steps pre {
    margin: 0;
    font-variant-ligatures: none;
    overflow-x: auto;
    max-inline-size: 100%;
  }
</style>
