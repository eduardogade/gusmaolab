---
// Temporary P05 design study of the physical folders. It is not a page of the website
// and not production content: it exists so the owner can judge the folder geometry.
// Its tabs are labels, not links: each case is a picture of one navigation state, and
// the synthetic third level has no pages. P06 updated case F to the Overview rule
// (D-050) and added case G. P07 added case H, a preview of a second-level folder; every
// unopened folder with children in every case shows its preview on hover. P08 added case
// I: wide content in the deepest folder, for the responsive checks. P09-A01 (D-076) made
// case E the four categories with nested folders, each in its own cardstock: every stack
// takes its colours from its own category, whatever the page's.
//
// Astro skips page files and folders whose names start with "_", so the /_design/
// prefix comes from this one-value dynamic segment. The underscore keeps design studies
// outside the navigation's namespace: no registry slug can start with "_".
import BaseLayout from "../../layouts/BaseLayout.astro"
import FolderStack from "../../components/folders/FolderStack.astro"
import { createNavigation, siteNavigation } from "../../navigation/index.ts"
import type {
  Navigation,
  NavigationEntry,
  NavigationState,
  SectionEnvironment,
} from "../../navigation/index.ts"
import { SECTIONS } from "../../navigation/registry.ts"

export function getStaticPaths() {
  return [{ params: { design: "_design" } }]
}

// Case C needs a third level, and none is approved yet (planning/information-
// architecture.md, section 3). These three folders are a synthetic fixture for this
// study only: they are not in the registry and have no pages.
const SYNTHETIC_LEVEL_3: NavigationEntry[] = [
  { id: "synthetic-projects", label: "Projects", slug: "synthetic-projects" },
  { id: "synthetic-themes", label: "Themes", slug: "synthetic-themes" },
  { id: "synthetic-datasets", label: "Datasets", slug: "synthetic-datasets" },
]
const syntheticNavigation = createNavigation(
  SECTIONS.map((section) =>
    section.id !== "cv"
      ? section
      : {
          ...section,
          children: section.children?.map((child) =>
            child.id === "cv-research" ? { ...child, children: SYNTHETIC_LEVEL_3 } : child,
          ),
        },
  ),
)

const stateAt = (navigation: Navigation, url: string): NavigationState => {
  const result = navigation.resolve(url)
  if (!result.found) throw new Error(`The folder study needs ${url}, which is not registered`)
  return result.state
}
// "core" is the default environment: no attribute. An environment is typography and
// texture; the colours come from each stack's category (FolderStack sets it).
const environmentOf = (state: NavigationState): SectionEnvironment | undefined =>
  state.environment === "core" ? undefined : state.environment

const home = stateAt(siteNavigation, "/")
const research = stateAt(siteNavigation, "/cv/research/")
const projects = stateAt(syntheticNavigation, "/cv/research/synthetic-projects/")
const outreach = stateAt(siteNavigation, "/cv/outreach/")
const cvOverview = stateAt(siteNavigation, "/cv/")
const researchOverview = stateAt(syntheticNavigation, "/cv/research/")
const syntheticCv = stateAt(syntheticNavigation, "/cv/")
const categoryCases = [
  {
    url: "/lab/research-areas/",
    name: "Research",
    text: "Cream terrain and almond cream folders on cream ivory paper, with an editorial serif for headings.",
  },
  {
    url: "/lecture-notes/greenhouse/",
    name: "Blog & Notes",
    text: "Cinnamon and apricot linen folders on peach ivory paper, with sans-serif headings for the lecture notes.",
  },
  {
    url: "/writing/kosmos/",
    name: "Writing",
    text: "Golden honey and golden cream folders on lemon ivory paper, with italic serif headings over serif body text.",
  },
  {
    url: "/bearnards-area/powerlifting/",
    name: "Bearnard",
    text: "Powder blue and pale glacier folders on snow white paper, the lightest cardstock, with bold Clarendon headings.",
  },
].map((item) => ({ ...item, state: stateAt(siteNavigation, item.url) }))

// The selected tab of every row, Overview included.
const selectionOf = (state: NavigationState) =>
  state.rows
    .map((row) => row.tabs.find((tab) => tab.id === row.selectedId)?.label)
    .join(" · ")
---

<BaseLayout
  title="GusmaoLab — physical folder study (P05, temporary)"
  description="Temporary design study for the GusmaoLab website: physical folder tabs, nested folders and their materials, approved by the owner."
>
  <div class="study" data-study="p05-folders">
    <header class="study-shell study-intro gl-on-dark">
      <p class="study-overline">Design study · P05 · Temporary</p>
      <h1>Physical Folder Geometry — P05 Visual Study</h1>
      <p class="study-lead">
        Paper folders with index tabs, nested up to three levels deep. This is a <strong>temporary design study</strong>,
        not the GusmaoLab website and not production content. The owner approved the folder
        appearance.
      </p>
      <ul class="study-notes" role="list">
        <li>
          Every tab, label and order comes from the P04 navigation registry, except the
          third level in cases C, G and H, which is a <strong>synthetic fixture</strong>.
        </li>
        <li>
          An open folder always has a selected tab in its row of children: its Overview
          when the folder's own page is open (P06).
        </li>
        <li>
          Tabs here are labels; on the site's pages they are links (P06). Hover an unopened
          folder that has folders inside it to see its preview (P07); here the previews are
          pictures too, and their items are not links. The full small-screen strategy is P08.
        </li>
        <li>
          Rows that do not fit scroll sideways inside their folder, never the page. A fade at
          an edge means more tabs lie beyond it.
        </li>
      </ul>
    </header>

    <section class="study-shell study-case" data-study-case="a" aria-labelledby="case-a">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case A · one level · Core</p>
        <h2 id="case-a">The eleven sections, Home open</h2>
        <p>
          The global row at full length: eleven tabs in the approved order, each in its own
          category's cardstock, whichever folder is open.
          Selection: <code>{selectionOf(home)}</code>, as resolved for <code>/</code>.
        </p>
      </header>
      <FolderStack state={home} links={false}>
        <div class="gl-prose sample">
          <p class="sample-overline">Home · sample content</p>
          <h3>Welcome to the archive</h3>
          <p class="sample-lead">
            Computational biology, teaching, writing and a navy bear in amber glasses, kept
            in one cabinet of paper folders.
          </p>
          <p>
            The selected tab and this folder are one sheet of card: same material, one
            continuous edge, and a V where the tab meets the body. The other ten tabs stand
            a little lower, behind its top edge, keep their own colors and stay readable.
          </p>
          <p>
            The reading surface is the category's lightest paper inside the open folder, so
            long text never sits on the darker card stock around it.
          </p>
        </div>
      </FolderStack>
    </section>

    <section class="study-shell study-case" data-study-case="b" data-environment={environmentOf(research)} aria-labelledby="case-b">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case B · two levels · Research</p>
        <h2 id="case-b">CV open, Research open inside it</h2>
        <p>
          The CV folder's body holds a second folder with its own row of tabs.
          Selection: <code>{selectionOf(research)}</code>, as resolved for <code>/cv/research/</code>.
        </p>
      </header>
      <FolderStack state={research} links={false}>
        <div class="gl-prose sample">
          <p class="sample-overline">CV · Research · sample content</p>
          <h3>Research</h3>
          <p>
            A lighter folder inside the first one: the category's level 2 cardstock. Both tab
            rows stay visible, so the path to this page is told by the folders themselves,
            without a breadcrumb.
          </p>
          <table>
            <thead>
              <tr><th scope="col">Theme</th><th scope="col">Methods</th></tr>
            </thead>
            <tbody>
              <tr><td>Chromatin conformation</td><td>Contact maps, polymer models</td></tr>
              <tr><td>Gene regulation</td><td>Probabilistic models, sequence analysis</td></tr>
              <tr><td>Methods and software</td><td>Reproducible pipelines, open tools</td></tr>
            </tbody>
          </table>
        </div>
      </FolderStack>
    </section>

    <section class="study-shell study-case" data-study-case="c" data-environment={environmentOf(projects)} aria-labelledby="case-c">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case C · three levels · Research</p>
        <h2 id="case-c">CV, Research and a third folder</h2>
        <p>
          The deepest stack the site allows. Selection: <code>{selectionOf(projects)}</code>. <strong>The third level is a synthetic fixture</strong>:
          Projects, Themes and Datasets are not registered folders and have no pages.
        </p>
      </header>
      <FolderStack state={projects} links={false}>
        <div class="gl-prose sample">
          <p class="sample-overline">Synthetic fixture · sample content</p>
          <h3>Projects</h3>
          <p>
            Three folders and the page, nested: the level 1 and level 2 cardstocks, then
            the category's lightest material for the third folder and its paper, set apart
            by edges and shadows. Deeper content, such as a single project, would open here,
            inside this third folder, never as a fourth row of tabs.
          </p>
          <ul>
            <li>Every level uses the same component; only its material and size change.</li>
            <li>Each level adds a small inset, so the reading area stays wide.</li>
          </ul>
          <pre tabindex="0" aria-label="Python code sample"><code>{`def gc_content(sequence: str) -> float:
    """Share of G and C bases in a DNA sequence."""
    return sum(base in "GC" for base in sequence) / len(sequence)`}</code></pre>
        </div>
      </FolderStack>
    </section>

    <section class="study-shell study-case" data-study-case="d" data-environment={environmentOf(outreach)} aria-labelledby="case-d">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case D · long labels, a stress test · Research</p>
        <h2 id="case-d">The longest labels in the registry</h2>
        <p>
          CV's eight folders include “Talks / Presentations”, “Mentoring / Supervision”,
          “Awards &amp; Honors” and “Outreach / Public Engagement”, here selected. The global
          row has “Lecture Notes” and “Bearnard's Area”. Labels are never shortened or
          truncated. A row this long is a stress test, not a typical page.
        </p>
      </header>
      <FolderStack state={outreach} links={false}>
        <div class="gl-prose sample">
          <p class="sample-overline">CV · Outreach / Public Engagement · sample content</p>
          <h3>Outreach / Public Engagement</h3>
          <p>
            Each tab is as wide as its label. When a row is wider than its folder it scrolls on
            its own, and the tabs keep their shape.
          </p>
        </div>
      </FolderStack>
    </section>

    <section class="study-group" aria-labelledby="case-e">
      <header class="study-shell case-head gl-on-dark">
        <p class="study-overline">Case E · categories</p>
        <h2 id="case-e">One folder system, five cardstocks</h2>
        <p>
          The same two-level stack in each category that has nested folders. Structure and
          geometry are identical; the category changes the cardstock and paper, and the
          section's environment changes the type. The shell, the links and the V never
          change. Case A shows Core.
        </p>
      </header>
      {
        categoryCases.map((item) => (
          <section
            class="study-shell study-case"
            data-study-case={`e-${item.state.category}`}
            data-environment={environmentOf(item.state)}
            aria-label={`${item.name} category`}
          >
            <header class="case-head gl-on-dark">
              <p class="study-overline">
                Case E · {item.name} · <code>{item.url}</code>
              </p>
              <p>{item.text}</p>
            </header>
            <FolderStack state={item.state} links={false}>
              <div class="gl-prose sample">
                <p class="sample-overline">{selectionOf(item.state)} · sample content</p>
                <h3>{item.state.folder.label}</h3>
                <p>
                  A folder of the {item.name} category: the same tabs, V, seams and
                  shadows, in this category's cardstock.
                </p>
              </div>
            </FolderStack>
          </section>
        ))
      }
    </section>

    <section class="study-shell study-case" data-study-case="f" data-environment={environmentOf(cvOverview)} aria-labelledby="case-f">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case F · an open parent · Research</p>
        <h2 id="case-f">CV open, its Overview selected</h2>
        <p>
          What <code>/cv/</code> shows since P06. Selection: <code>{selectionOf(cvOverview)}</code>. CV's row of folders starts with Overview, which stands for CV's own page and is
          selected, so no row of tabs is ever left unselected. Overview links to <code>/cv/</code>; there is no separate overview address.
        </p>
      </header>
      <FolderStack state={cvOverview} links={false}>
        <div class="gl-prose sample">
          <p class="sample-overline">CV · Overview · sample content</p>
          <h3>Curriculum vitae</h3>
          <p>
            The overview page opens inside CV's folder like any other. Its tab is the first in
            the row, ahead of the folders it introduces.
          </p>
        </div>
      </FolderStack>
    </section>

    <section class="study-shell study-case" data-study-case="g" data-environment={environmentOf(researchOverview)} aria-labelledby="case-g">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case G · three levels, an open parent · Research</p>
        <h2 id="case-g">Research open, its Overview selected</h2>
        <p>
          If Research had folders of its own, <code>/cv/research/</code> would open a third row with its Overview selected. Selection: <code>{selectionOf(researchOverview)}</code>. <strong>The third level is the synthetic fixture</strong> of case C. Without such folders,
          Research ends at the second level, as in case B.
        </p>
      </header>
      <FolderStack state={researchOverview} links={false}>
        <div class="gl-prose sample">
          <p class="sample-overline">Synthetic fixture · sample content</p>
          <h3>Research</h3>
          <p>
            The same rule at the third level: Research's own page opens in its folder, behind
            an Overview tab, and Projects, Themes and Datasets stand beside it.
          </p>
        </div>
      </FolderStack>
    </section>

    <section class="study-shell study-case" data-study-case="h" data-environment={environmentOf(syntheticCv)} aria-labelledby="case-h">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case H · a second-level preview · Research</p>
        <h2 id="case-h">CV open; hover Research to preview it</h2>
        <p>
          Selection: <code>{selectionOf(syntheticCv)}</code>. Here Research has folders of its own, from <strong>the synthetic fixture</strong> of case C, so hovering its
          tab shows a preview of Research's Overview, Projects, Themes and Datasets: one level, never deeper. CV, which is open, shows no preview: its folders are
          already the row below it. The selection and the V do not move.
        </p>
      </header>
      <FolderStack state={syntheticCv} links={false}>
        <div class="gl-prose sample">
          <p class="sample-overline">Synthetic fixture · sample content</p>
          <h3>Curriculum vitae</h3>
          <p>
            A preview is a slip of paper hanging from its tab, not a folder: it has no tab,
            no V and no body, and it closes when the pointer leaves.
          </p>
        </div>
      </FolderStack>
    </section>

    <section class="study-shell study-case" data-study-case="i" data-environment={environmentOf(projects)} aria-labelledby="case-i">
      <header class="case-head gl-on-dark">
        <p class="study-overline">Case I · wide content in three levels · Research</p>
        <h2 id="case-i">Code, tables, formulas and long words in the deepest folder</h2>
        <p>
          Selection: <code>{selectionOf(projects)}</code>, the synthetic fixture of case C. <strong>Sample content for layout testing only.</strong> Each wide element
          scrolls inside itself; the page never scrolls sideways (P08).
        </p>
      </header>
      <FolderStack state={projects} links={false}>
        <div class="gl-prose sample" data-overflow-sample>
          <p class="sample-overline">Synthetic fixture · layout sample</p>
          <h3>Contact-probability decay along chromosomesofunusuallylongcompoundwordlength</h3>
          <p>
            A sample paragraph: in a polymer model of chromatin, the probability that two loci touch falls with
            their genomic distance. Text like this must reflow to any width without leaving the paper.
          </p>
          <pre tabindex="0" aria-label="Wide code sample"><code>{`contact_probability = lambda distance, exponent=1.08, scale=1.0e-3: scale * distance ** (-exponent)  # a deliberately long line`}</code></pre>
          <div class="gl-scroll-x" tabindex="0" role="region" aria-label="Wide sample table">
            <table>
              <thead>
                <tr>
                  {["Sample", "Reads", "Mapped", "Duplicates", "Contacts", "Cis", "Trans", "Resolution"].map((h) => <th scope="col">{h}</th>)}
                </tr>
              </thead>
              <tbody>
                {["A", "B", "C"].map((name, i) => (
                  <tr>
                    <td>Sample {name}</td>
                    {[1_200_000 + i, 1_100_000 + i, 90_000 + i, 800_000 + i, 600_000 + i, 200_000 + i].map((n) => <td>{n.toLocaleString("en")}</td>)}
                    <td>5&nbsp;kb</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <math display="block" aria-label="A wide sample formula">
            <mrow>
              <mi>P</mi><mo>(</mo><mi>s</mi><mo>)</mo><mo>=</mo>
              <mi>A</mi><msup><mi>s</mi><mrow><mo>−</mo><mi>α</mi></mrow></msup>
              <mo>+</mo><mi>B</mi><msup><mi>s</mi><mrow><mo>−</mo><mi>β</mi></mrow></msup>
              <mo>+</mo><mi>C</mi><msup><mi>e</mi><mrow><mo>−</mo><mi>s</mi><mo>/</mo><mi>λ</mi></mrow></msup>
              <mo>+</mo><mi>D</mi><mi>log</mi><mo>(</mo><mn>1</mn><mo>+</mo><mi>s</mi><mo>/</mo><msub><mi>s</mi><mn>0</mn></msub><mo>)</mo>
              <mo>+</mo><mi>E</mi><msup><mi>s</mi><mrow><mo>−</mo><mn>2</mn></mrow></msup>
            </mrow>
          </math>
          <figure>
            <svg class="sample-figure" viewBox="0 0 600 160" role="img" aria-label="A sample curve that falls steeply, then slowly">
              <path d="M10 10 C 80 120, 200 140, 590 150" fill="none" stroke="currentColor" stroke-width="3" />
              <path d="M10 150 H 590 M10 10 V 150" fill="none" stroke="currentColor" stroke-width="1" />
            </svg>
            <figcaption>A sample figure: it scales to the width of the paper.</figcaption>
          </figure>
          <ul>
            <li>A sample list item.</li>
            <li>An address that must wrap: https://www.gusmaolab.org/lecture-notes/the-greenhouse/an-unusually-long-address-for-layout-testing/</li>
          </ul>
          <dl>
            <dt>Source: https://www.gusmaolab.org/lab/resources/an-equally-long-address-in-a-definition-term/</dt>
            <dd>A sample definition. Terms are not wrapped by the typography rules, so the paper wraps them.</dd>
          </dl>
          <blockquote>
            <p>A sample quotation, set in the editorial face, as essays and lecture notes will use it.</p>
          </blockquote>
        </div>
      </FolderStack>
    </section>
  </div>
</BaseLayout>

<style>
  /* Study layout only. The folders themselves are styled by src/styles/folders.css. */
  .study {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-l);
    max-inline-size: var(--size-shell-max);
    margin-inline: auto;
    padding: var(--space-gutter);
  }

  .study-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-s);
  }

  .study-shell {
    padding: var(--space-shell-padding);
    border: var(--border-width-hairline) solid var(--color-shell-border);
    border-radius: var(--radius-shell);
    background-color: var(--color-shell);
    box-shadow: var(--shadow-shell);
  }

  .study-intro {
    padding: var(--space-content-block) var(--space-content-inline);
  }

  .study-intro h1 {
    max-inline-size: 24ch;
    font-size: var(--font-size-h1);
  }

  .study-lead {
    max-inline-size: var(--measure-prose);
    margin-block-start: var(--space-s);
    font-size: var(--font-size-lead);
  }

  .study-notes {
    display: grid;
    gap: var(--space-2xs);
    max-inline-size: var(--measure-prose);
    margin-block: var(--space-m) 0;
    padding-inline-start: var(--space-m);
    color: var(--color-text-on-dark-muted);
  }

  .study-overline,
  .sample-overline {
    font-family: var(--font-label);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    text-transform: uppercase;
  }

  .study-overline {
    margin-block-end: var(--space-3xs);
    color: var(--color-text-on-dark-muted);
  }

  .case-head {
    display: grid;
    gap: var(--space-3xs);
    padding: var(--space-2xs) var(--space-xs) var(--space-s);
  }

  .case-head h2 {
    font-size: var(--font-size-h3);
  }

  .case-head p {
    max-inline-size: var(--measure-wide);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-ui);
  }

  .case-head .study-overline {
    font-size: var(--font-size-xs);
  }

  .sample-overline {
    color: var(--color-text-muted);
  }

  .sample-lead {
    font-size: var(--font-size-lead);
  }

  .sample table {
    font-size: var(--font-size-sm);
  }

  .sample-figure {
    inline-size: 100%;
    block-size: auto;
    color: var(--color-text-secondary);
  }

  .sample figcaption {
    margin-block-start: var(--space-2xs);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }
</style>
