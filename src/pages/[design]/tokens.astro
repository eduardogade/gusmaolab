---
// Temporary P03 design specimen. It is not the GusmaoLab homepage: it exists so the owner
// can review colours, type, materials and environments. Every hex value and contrast
// ratio shown is read from the token stylesheets at build time, so the page cannot drift
// from them.
//
// P09-A01 (D-076) replaced its colours with the Chromatic Archive: the five locked
// category palettes are read from categories.css, and Specimen D shows each pairing of a
// category (colour) and an environment (typography and texture) that the registry uses.
//
// It was the temporary homepage until P06, which moved it unchanged to /_design/tokens/
// (D-055); the /_design/ prefix comes from the one-value dynamic segment, as for the
// folder study (D-048).
import BaseLayout from "../../layouts/BaseLayout.astro"
import { CATEGORIES, CONTRAST_PAIRS, ENVIRONMENTS } from "../../design/contract.mjs"
import { contrastRatio, readTokens } from "../../design/css-tokens.mjs"
import { siteNavigation } from "../../navigation/index.ts"
import categoriesCss from "../../styles/categories.css?raw"
import environmentsCss from "../../styles/environments.css?raw"
import tokensCss from "../../styles/tokens.css?raw"

import { demosEnabled } from "../../editorial/demo.ts"

export function getStaticPaths() {
  return demosEnabled() ? [{ params: { design: "_design" } }] : []
}

const tokens = readTokens(tokensCss, categoriesCss, environmentsCss)
// `scope` is a category ID; without one a value is Core's, the default.
const hex = (name: string, scope?: string) => tokens.color(name, scope).hex.toUpperCase()
const ratioOf = (foreground: string, background: string, scope?: string) =>
  contrastRatio(tokens.color(foreground, scope).rgba, tokens.color(background, scope).rgba)
const show = (ratio: number) => `${(Math.floor(ratio * 10) / 10).toFixed(1)}:1`
const stack = (name: string) => tokens.resolve(name).text

const scopes = CATEGORIES.map((category) => category.id)
const enforced = CONTRAST_PAIRS.filter((pair) => pair.min !== null)
const contrastChecks = scopes.flatMap((scope) =>
  enforced.map((pair) => ratioOf(pair.foreground, pair.background, scope) >= (pair.min ?? 0)),
)
const contrastPassing = contrastChecks.filter(Boolean).length

const foundations = [
  { token: "--palette-deep-charcoal", name: "Deep charcoal", role: "The shell, in every category (locked)" },
  { token: "--palette-forest-teal", name: "Forest teal", role: "Links and the accent, in every category (locked)" },
  { token: "--palette-midnight-ink", name: "Midnight ink", role: "The V on the selected tab (locked)" },
  { token: "--palette-espresso", name: "Espresso", role: "Primary text and headings" },
  { token: "--palette-warm-brown", name: "Warm brown", role: "Bear-pride brown" },
  { token: "--palette-ember", name: "Ember", role: "Bear-pride orange; Bearnard's flannel" },
  { token: "--palette-honey", name: "Muted honey", role: "Focus on dark surfaces; text selection" },
  { token: "--palette-kraft", name: "Kraft", role: "Muted text on the shell" },
  { token: "--palette-parchment", name: "Parchment", role: "Text on the shell; bear-pride tan" },
  { token: "--palette-ivory", name: "Warm ivory", role: "Edge highlights; bear-pride white" },
  { token: "--palette-navy", name: "Midnight navy", role: "Bearnard's fur; focus ring" },
  { token: "--palette-charcoal", name: "Charcoal", role: "Bear-pride black" },
]

const supporting = [
  { token: "--palette-bark", name: "Bark", role: "Shadows, flannel bands, tab labels" },
  { token: "--palette-umber", name: "Umber", role: "Secondary text" },
  { token: "--palette-cocoa", name: "Cocoa", role: "Muted text, darkened with umber" },
  { token: "--palette-gold", name: "Gold", role: "Bear-pride gold" },
  { token: "--palette-eye-green", name: "Eye green", role: "Bearnard's eyes; links on the shell" },
  { token: "--palette-ash", name: "Ash", role: "Bear-pride gray; disabled states" },
]

// The Chromatic Archive (P09-A01): the five rows of the locked palette, read per category.
// The primitive a category token points at, and the owner's name for that color:
// --palette-charcoal-terrain is "Charcoal Terrain".
const primitiveOf = (token: string, category: string) =>
  tokens.declaration(token, category)?.value.match(/--palette-[\w-]+/)?.[0] ?? ""
const colorName = (token: string, category: string) =>
  primitiveOf(token, category)
    .replace("--palette-", "")
    .split("-")
    .map((word) => word[0].toUpperCase() + word.slice(1))
    .join(" ")
const paletteRows = [
  { token: "--color-backdrop", name: "Flannel ground" },
  { token: "--color-flannel-line", name: "Flannel line" },
  { token: "--color-folder-parent", name: "Tab and folder, level 1" },
  { token: "--color-folder-nested", name: "Tab and folder, level 2" },
  { token: "--color-folder-active", name: "Reading paper" },
]

const pride = [
  { token: "--color-pride-brown", stripe: "Dark brown" },
  { token: "--color-pride-orange", stripe: "Orange and rust" },
  { token: "--color-pride-gold", stripe: "Golden yellow" },
  { token: "--color-pride-tan", stripe: "Cream and tan" },
  { token: "--color-pride-white", stripe: "White" },
  { token: "--color-pride-gray", stripe: "Gray" },
  { token: "--color-pride-black", stripe: "Black" },
]

const roles = [
  { token: "--color-backdrop", role: "Flannel lining and its plain fallback" },
  { token: "--color-shell", role: "The main shell around the site" },
  { token: "--color-folder-parent", role: "Parent folder material" },
  { token: "--color-folder-tab-inactive", role: "Inactive tabs, sunk toward the shell" },
  { token: "--color-folder-nested", role: "Nested folder material" },
  { token: "--color-folder-active", role: "Active reading paper" },
  { token: "--color-text-primary", role: "Primary text" },
  { token: "--color-text-link", role: "Links on paper" },
  { token: "--color-accent", role: "Decorative accent" },
  { token: "--color-indicator-selected", role: "The V-shaped selection indicator" },
  { token: "--color-focus-ring", role: "Keyboard focus on paper" },
  { token: "--color-focus-ring-on-dark", role: "Keyboard focus on the shell" },
]

const layers = [
  { token: "--color-shell", name: "Main shell", note: "The dark frame, the same in every category." },
  {
    token: "--color-folder-parent",
    name: "Parent folder",
    note: "The category's level 1 cardstock. Its tab shares it.",
  },
  {
    token: "--color-folder-nested",
    name: "Nested folder",
    note: "Level 2 cardstock: one step lighter, not a leap.",
  },
  {
    token: "--color-folder-active",
    name: "Active reading paper",
    note: "The lightest and quietest, because reading happens here.",
  },
]

const samples: Record<string, { heading: string; text: string; link: string; code?: string }> = {
  core: {
    heading: "About",
    text: "Who runs the lab, what it studies and how to get in touch: the plain front office of the archive.",
    link: "Read about the lab",
  },
  scientific: {
    heading: "Research",
    text: "Chromatin conformation, gene regulation and the probabilistic models that read them, with the methods and data behind each result.",
    link: "Read the research notes",
  },
  technical: {
    heading: "Lecture Notes",
    text: "Hidden Markov models and dynamic programming, with runnable code and the occasional mathematical pun.",
    code: "viterbi(observations, states)",
    link: "Open the notes",
  },
  literary: {
    heading: "Writing",
    text: "Literary experiments deserve a quieter page: an honest serif, generous margins and room for a footnote or two.",
    link: "Begin reading",
  },
  personal: {
    heading: "Bear Life",
    text: "Photos, training logs and Bearnard's own corner. More character, and still the same archive.",
    link: "Visit Bearnard's Area",
  },
}

// Every pairing of a category and an environment that the registry uses, in the
// categories' order, with the sections that have it.
const environmentName = (id: string) =>
  ENVIRONMENTS.find((env) => env.id === id)?.name ?? "Core"
const pairingCards = CATEGORIES.flatMap((category) => {
  const sections = siteNavigation.sections.filter((section) => section.category === category.id)
  const environments = [...new Set(sections.map((section) => section.environment))]
  return environments.map((environment) => ({
    category,
    environment,
    environmentName: environmentName(environment),
    sections: sections
      .filter((section) => section.environment === environment)
      .map((section) => section.label),
    sample: samples[environment],
    ratios: [
      { label: "Text", value: show(ratioOf("--color-text-primary", "--color-folder-active", category.id)) },
      { label: "Link", value: show(ratioOf("--color-text-link", "--color-folder-active", category.id)) },
      { label: "Muted", value: show(ratioOf("--color-text-muted", "--color-folder-active", category.id)) },
      { label: "On shell", value: show(ratioOf("--color-text-on-dark", "--color-shell", category.id)) },
    ],
  }))
})
---

<BaseLayout
  title="GusmaoLab — design study (P03, temporary)"
  description="Temporary design specimen for the GusmaoLab website: the Chromatic Archive palettes, typography, paper materials and section environments."
>
  <div class="frame" data-specimen="p03">
    <div class="shell">
      <header class="masthead gl-on-dark">
        <p class="wordmark">
          <span class="pride-mark" aria-hidden="true"></span>
          <span class="wordmark-name">Gusmao<b>Lab</b></span>
        </p>
        <p class="masthead-note">
          Design study · P03 · <strong>Temporary specimen</strong>, awaiting the owner's review
        </p>
      </header>

      <div class="folder">
        <section class="sheet hero" aria-labelledby="specimen-title">
          <p class="overline">Visual foundations · first candidate</p>
          <h1 id="specimen-title" class="display">
            <span>The Lumberjack's</span> <b>Archive</b>
          </h1>
          <p class="lead">
            Paper folders in five cardstocks and a flannel lining, with a navy bear who is
            welcome in every room of the lab.
          </p>
          <div class="hero-body">
            <p>
              This page is a <strong>temporary design study</strong>, not the GusmaoLab
              homepage. It shows the palette, typefaces, paper materials and section
              environments. The colours are the Chromatic Archive, approved and locked by the
              owner (P09-A01); the typefaces were approved in P03.
            </p>
            <p class="muted">
              Bioinformatics, AI, personal projects, literary experiments and occasional
              mathematical puns all have to feel at home here, so nothing is stern and
              nothing is shouting.
            </p>
          </div>
          <ul class="principles" role="list">
            <li>
              <span class="principle-mark mark-identity" aria-hidden="true"></span>
              <strong>Identity</strong>
              <span>The bear-pride stripe family: brown, rust, gold, tan, white, gray, black.</span>
            </li>
            <li>
              <span class="principle-mark mark-character" aria-hidden="true">
                <i></i><i></i><i></i><i></i>
              </span>
              <strong>Character</strong>
              <span>Bearnard: midnight-navy fur, green eyes, amber glasses, cream markings.</span>
            </li>
            <li>
              <span class="principle-mark mark-atmosphere gl-flannel" aria-hidden="true"></span>
              <strong>Atmosphere</strong>
              <span>A quiet flannel lining around the archive, never behind text.</span>
            </li>
            <li>
              <span class="principle-mark mark-structure" aria-hidden="true"><i></i></span>
              <strong>Structure</strong>
              <span>Real paper folders, each category in its own cardstock.</span>
            </li>
          </ul>
        </section>

        <section class="sheet" id="palette" aria-labelledby="palette-title">
          <header class="sheet-head">
            <p class="overline">Specimen A</p>
            <h2 id="palette-title">Identity palette</h2>
            <p class="sheet-intro">
              Twelve foundation colors are the same on every page: the locked shell, link
              and V colors, the text inks and the identity. Six supporting tones serve
              specific roles. The cardstock is separate: five category palettes, below.
              Components never use these primitives directly, only semantic roles. The hex
              values are read from <code>src/styles/tokens.css</code> and
              <code>src/styles/categories.css</code> when the site is built.
            </p>
          </header>

          <h3 class="group-title">Foundations</h3>
          <ul class="swatches" role="list">
            {
              foundations.map((swatch) => (
                <li class="swatch">
                  <span class="swatch-chip" style={`--chip: var(${swatch.token})`} />
                  <span class="swatch-name">{swatch.name}</span>
                  <span class="swatch-code">
                    <code>{swatch.token}</code>
                    <code>{hex(swatch.token)}</code>
                  </span>
                  <span class="swatch-role">{swatch.role}</span>
                </li>
              ))
            }
          </ul>

          <div class="palette-split">
            <div>
              <h3 class="group-title">The bear-pride stripe family</h3>
              <ol class="pride" role="list">
                {
                  pride.map((band) => (
                    <li>
                      <span class="pride-band" style={`--chip: var(${band.token})`} />
                      <span class="pride-label">
                        <strong>{band.stripe}</strong>
                        <code>{hex(band.token)}</code>
                      </span>
                    </li>
                  ))
                }
              </ol>
              <p class="note">
                Palette interpretations of the seven-stripe family, toned to sit with the
                rest of the palette. They are not certified flag values.
              </p>
            </div>
            <div>
              <h3 class="group-title">Supporting tones</h3>
              <ul class="tones" role="list">
                {
                  supporting.map((swatch) => (
                    <li>
                      <span class="tone-chip" style={`--chip: var(${swatch.token})`} />
                      <span class="tone-text">
                        <strong>{swatch.name}</strong> <code>{hex(swatch.token)}</code>
                        <span>{swatch.role}</span>
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>

          <h3 class="group-title" id="archive-title">The Chromatic Archive: five category palettes</h3>
          <div class="table-wrap" role="region" aria-labelledby="archive-title" tabindex="0">
            <table class="archive">
              <thead>
                <tr>
                  <th scope="col">Element</th>
                  {
                    CATEGORIES.map((category) => (
                      <th scope="col">
                        {category.name}
                        <span class="archive-sections">{category.sections.join(", ")}</span>
                      </th>
                    ))
                  }
                </tr>
              </thead>
              <tbody>
                {
                  paletteRows.map((row) => (
                    <tr>
                      <th scope="row">
                        {row.name}
                        <code>{row.token}</code>
                      </th>
                      {CATEGORIES.map((category) => (
                        <td class="role-value" data-category={category.id}>
                          <span class="role-chip" style={`--chip: var(${row.token})`} />
                          <span class="archive-color">
                            {colorName(row.token, category.id)}
                            <code>{hex(row.token, category.id)}</code>
                            <code>{primitiveOf(row.token, category.id)}</code>
                          </span>
                        </td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
          <p class="note">
            Locked by the owner. A top-level tab keeps its category's level 1 color on every
            page; the open folder's category colors the flannel, the folder bodies and the
            paper.
          </p>

          <h3 class="group-title" id="roles-title">Semantic roles on a Core page</h3>
          <div class="table-wrap" role="region" aria-labelledby="roles-title" tabindex="0">
            <table>
              <thead>
                <tr>
                  <th scope="col">Role token</th>
                  <th scope="col">Value</th>
                  <th scope="col">Used for</th>
                </tr>
              </thead>
              <tbody>
                {
                  roles.map((row) => (
                    <tr>
                      <td>
                        <code>{row.token}</code>
                      </td>
                      <td class="role-value">
                        <span class="role-chip" style={`--chip: var(${row.token})`} />
                        <code>{hex(row.token)}</code>
                      </td>
                      <td>{row.role}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <section class="sheet" id="typography" aria-labelledby="typography-title">
          <header class="sheet-head">
            <p class="overline">Specimen B</p>
            <h2 id="typography-title">Typography</h2>
            <p class="sheet-intro">
              Four roles, all from fonts already installed on readers' devices, so nothing is
              downloaded or redistributed. Where a face is missing, its stack falls back to a
              close relative.
            </p>
          </header>

          <div class="type-grid">
            <figure class="type-card type-card-wide">
              <figcaption class="type-label">
                Display · <code>--font-display</code> · light and bold · <code>--font-size-display</code>
              </figcaption>
              <p class="sample-display">Field notes on the <b>folded genome</b></p>
              <p class="type-stack">{stack("--font-display")}</p>
            </figure>

            <figure class="type-card">
              <figcaption class="type-label">
                Section heading · <code>--font-heading</code> · <code>--font-size-h2</code>
              </figcaption>
              <p class="sample-heading">Chromatin conformation and gene regulation</p>
              <p class="type-stack">Core environment: the display face at regular weight</p>
            </figure>

            <figure class="type-card">
              <figcaption class="type-label">
                Interface and body · <code>--font-interface</code> · <code>--font-size-body</code>
              </figcaption>
              <p>
                GusmaoLab gathers research, software, teaching and writing in one archive.
                Each section is a folder with its own paper, and Bearnard is allowed in all of
                them, including the CV.
              </p>
              <p class="type-stack">{stack("--font-interface")}</p>
            </figure>

            <figure class="type-card">
              <figcaption class="type-label">
                Editorial · <code>--font-editorial</code> · literary pages
              </figcaption>
              <p class="sample-editorial">
                Every archive keeps two kinds of record: the ones it meant to keep, and the
                ones that slipped in between the folders. A ticket stub, a pressed leaf, a note
                in pencil that only makes sense years later.
              </p>
              <p class="type-stack">{stack("--font-editorial")}</p>
            </figure>

            <figure class="type-card type-card-wide type-card-code">
              <figcaption class="type-label">
                Code · <code>--font-mono</code> · <code>--font-size-code-block</code>
              </figcaption>
              <pre tabindex="0" aria-label="Python code sample"><code>{`def reverse_complement(sequence: str) -> str:
    """Return the reverse complement of a DNA sequence."""
    pairs = str.maketrans("ACGTacgt", "TGCAtgca")
    return sequence.translate(pairs)[::-1]`}</code></pre>
              <p class="type-stack">{stack("--font-mono")}</p>
            </figure>

            <figure class="type-card">
              <figcaption class="type-label">
                Mathematics · <code>--font-math</code> · MathML
              </figcaption>
              <math display="block" class="sample-math">
                <mrow>
                  <mi>H</mi><mo stretchy="false">(</mo><mi>X</mi><mo stretchy="false">)</mo>
                  <mo>=</mo><mo>−</mo>
                  <munder><mo>∑</mo><mrow><mi>x</mi><mo>∈</mo><mi>𝒳</mi></mrow></munder>
                  <mi>p</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo>
                  <msub><mi>log</mi><mn>2</mn></msub>
                  <mi>p</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo>
                </mrow>
              </math>
              <p class="type-stack">Shannon entropy, as used for sequence-motif information</p>
            </figure>

            <figure class="type-card">
              <figcaption class="type-label">Quotation · <code>--color-surface-quote</code></figcaption>
              <blockquote>
                <p>
                  From so simple a beginning endless forms most beautiful and most wonderful
                  have been, and are being, evolved.
                </p>
              </blockquote>
              <p class="type-stack">Charles Darwin, <cite>On the Origin of Species</cite> (1859)</p>
            </figure>

            <figure class="type-card">
              <figcaption class="type-label">
                Muted supporting text · <code>--color-text-muted</code>
              </figcaption>
              <p class="muted">
                Figure 2. Muted text is for captions, dates and quiet metadata. It still
                clears 4.5:1 on every paper.
              </p>
              <p class="sample-small">
                Run <code>npm run verify</code> before committing; press <kbd>Tab</kbd> to move
                focus.
              </p>
            </figure>

            <figure class="type-card type-card-wide">
              <figcaption class="type-label">
                Folder-label roles · <code>--font-size-tab-1</code> to <code>-3</code> · labels
                only, no tabs yet
              </figcaption>
              <dl class="tab-labels">
                <div>
                  <dt>Level 1</dt>
                  <dd class="tab-label-1">Research</dd>
                </div>
                <div>
                  <dt>Level 2</dt>
                  <dd class="tab-label-2">Publications</dd>
                </div>
                <div>
                  <dt>Level 3</dt>
                  <dd class="tab-label-3">Chromatin architecture</dd>
                </div>
                <div>
                  <dt>Hover preview</dt>
                  <dd class="tab-label-preview">Immediate children only</dd>
                </div>
              </dl>
            </figure>
          </div>
        </section>

        <section class="sheet" id="materials" aria-labelledby="materials-title">
          <header class="sheet-head">
            <p class="overline">Specimen C</p>
            <h2 id="materials-title">Paper and materials</h2>
            <p class="sheet-intro">
              A small number of surfaces, each a step from the last. Depth comes from edges
              and soft shadows as much as from lightness, so deeper folders never jump in
              brightness.
            </p>
          </header>

          <div class="materials">
            <figure class="stack">
              <div class="layer layer-shell">
                <p class="layer-label gl-on-dark">
                  <strong>{layers[0].name}</strong>
                  <code>{layers[0].token}</code>
                  <span>{hex(layers[0].token)} · {layers[0].note}</span>
                </p>
                <div class="layer layer-parent">
                  <p class="layer-label">
                    <strong>{layers[1].name}</strong>
                    <code>{layers[1].token}</code>
                    <span>{hex(layers[1].token)} · {layers[1].note}</span>
                  </p>
                  <div class="layer layer-nested">
                    <p class="layer-label">
                      <strong>{layers[2].name}</strong>
                      <code>{layers[2].token}</code>
                      <span>{hex(layers[2].token)} · {layers[2].note}</span>
                    </p>
                    <div class="layer layer-active">
                      <p class="layer-label">
                        <strong>{layers[3].name}</strong>
                        <code>{layers[3].token}</code>
                        <span>{hex(layers[3].token)} · {layers[3].note}</span>
                      </p>
                    </div>
                  </div>
                </div>
              </div>
              <figcaption class="note">
                Rectangular specimens only. The connected tab silhouettes come in P05–P07.
              </figcaption>
            </figure>

            <div class="material-side">
              <div class="textiles">
                <figure>
                  <div class="textile gl-flannel"></div>
                  <figcaption>
                    <strong>Flannel lining</strong>{" "}
                    CSS gradients only, no image files. Strength 1, set by <code>--texture-flannel-strength</code>.
                  </figcaption>
                </figure>
                <figure>
                  <div class="textile textile-plain"></div>
                  <figcaption>
                    <strong>Plain fallback</strong>{" "}
                    <code>{hex("--color-backdrop")}</code>, used in high-contrast and forced-colors
                    modes or with the texture switched off.
                  </figcaption>
                </figure>
              </div>

              <ul class="depths" role="list">
                <li>
                  <span class="depth-tile depth-edge"></span>
                  <strong>Edge highlight</strong>
                  <code>--color-folder-edge</code>
                </li>
                <li>
                  <span class="depth-tile depth-recess"></span>
                  <strong>Recess</strong>
                  <code>--shadow-recess</code>
                </li>
                <li>
                  <span class="depth-tile depth-paper"><i></i></span>
                  <strong>Resting paper</strong>
                  <code>--shadow-paper</code>
                </li>
                <li>
                  <span class="depth-tile depth-raised"><i></i></span>
                  <strong>Raised paper</strong>
                  <code>--shadow-paper-raised</code>
                </li>
              </ul>

              <aside class="mascot-slot" aria-labelledby="mascot-title">
                <div class="mascot-frame" aria-hidden="true">
                  <span>Bearnard</span>
                </div>
                <div class="mascot-text">
                  <h3 id="mascot-title">Mascot slot</h3>
                  <p>
                    Reserved for an approved Bearnard derivative. This study shows no mascot
                    image: the canonical masters stay untouched and out of the site.
                  </p>
                  <ul class="bear-colors" role="list">
                    <li><i style="--chip: var(--palette-navy)"></i>Navy fur</li>
                    <li><i style="--chip: var(--palette-eye-green)"></i>Green eyes</li>
                    <li><i style="--chip: var(--palette-honey)"></i>Amber glasses</li>
                    <li><i style="--chip: var(--palette-ember)"></i>Flannel</li>
                  </ul>
                </div>
              </aside>
            </div>
          </div>
        </section>

        <section class="sheet" id="environments" aria-labelledby="environments-title">
          <header class="sheet-head">
            <p class="overline">Specimen D</p>
            <h2 id="environments-title">Categories and environments</h2>
            <p class="sheet-intro">
              One folder system. A section's category chooses its colors
              (<code>data-category</code>: flannel, folder and paper) and its environment
              chooses its typography and texture (<code>data-environment</code>). The shell,
              links, accent and V are the same in every panel. These are the pairings the
              site uses.
            </p>
          </header>

          <div class="environments">
            {
              pairingCards.map((env) => (
                <figure class="env-figure">
                  <div
                    class="env"
                    data-category={env.category.id}
                    data-environment={env.environment === "core" ? undefined : env.environment}
                  >
                    <div class="env-lining gl-flannel">
                      <div class="env-shell">
                        <p class="env-name gl-on-dark">
                          <strong>
                            {env.category.name} · {env.environmentName}
                          </strong>
                          <span>{env.sections.join(" · ")}</span>
                        </p>
                        <div class="env-folder">
                          <div class="env-paper">
                            <h3>{env.sample.heading}</h3>
                            <p>{env.sample.text}</p>
                            {env.sample.code && (
                              <p>
                                <code>{env.sample.code}</code>
                              </p>
                            )}
                            <p>
                              <a href="#environments">{env.sample.link}</a>
                            </p>
                            <p class="env-chips">
                              <span class="env-accent" />
                              <span class="env-indicator">
                                <i />
                              </span>
                              <span class="muted">Accent and selection colors</span>
                            </p>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  <figcaption class="env-contrast">
                    {env.ratios.map((r) => (
                      <span>
                        {r.label} <strong>{r.value}</strong>
                      </span>
                    ))}
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </section>

        <section class="sheet" id="interaction" aria-labelledby="interaction-title">
          <header class="sheet-head">
            <p class="overline">Specimen E</p>
            <h2 id="interaction-title">Interaction states</h2>
            <p class="sheet-intro">
              Static examples sit next to live ones. Press <kbd>Tab</kbd> to move the focus
              ring through the live link and buttons; nothing here navigates anywhere.
            </p>
          </header>

          <div class="states">
            <div class="state-group">
              <h3 class="group-title">On reading paper</h3>
              <dl class="state-list">
                <div>
                  <dt>Link</dt>
                  <dd><a href="#interaction">Chromatin architecture notes</a></dd>
                </div>
                <div>
                  <dt>Hover, shown statically</dt>
                  <dd><span class="demo-link-hover">Chromatin architecture notes</span></dd>
                </div>
                <div>
                  <dt>Keyboard focus, shown statically</dt>
                  <dd><span class="demo-focus">Open the Research folder</span></dd>
                </div>
                <div>
                  <dt>Live focus on a control</dt>
                  <dd><button type="button" class="demo-button">Sample button</button></dd>
                </div>
                <div>
                  <dt>Active state</dt>
                  <dd><span class="demo-active">Research, the open folder</span></dd>
                </div>
                <div>
                  <dt>Selection indicator on tab material</dt>
                  <dd>
                    <span class="demo-indicator">Research<i aria-hidden="true"></i></span>
                  </dd>
                </div>
                <div>
                  <dt>Muted text</dt>
                  <dd><span class="muted">Captions, dates and quiet metadata</span></dd>
                </div>
                <div>
                  <dt>Disabled control</dt>
                  <dd>
                    <button type="button" class="demo-button" disabled>Not available yet</button>
                  </dd>
                </div>
              </dl>
            </div>

            <div class="state-group state-dark gl-on-dark">
              <h3 class="group-title">On the dark shell</h3>
              <dl class="state-list">
                <div>
                  <dt>Link</dt>
                  <dd><a href="#interaction">Read the lab notes</a></dd>
                </div>
                <div>
                  <dt>Keyboard focus, shown statically</dt>
                  <dd><span class="demo-focus">Open the Lab folder</span></dd>
                </div>
                <div>
                  <dt>Muted text</dt>
                  <dd><span class="muted">Secondary labels on the shell</span></dd>
                </div>
              </dl>
              <p class="state-summary">
                Contrast: {contrastPassing} of {contrastChecks.length} checked pairings meet
                their WCAG minimum across the five categories.
              </p>
            </div>
          </div>
        </section>
      </div>

      <footer class="colophon gl-on-dark">
        <p>Temporary design study for P03. Not the final homepage, and not deployed.</p>
        <p>
          Values in <code>src/styles/</code> · contrast checks in <code>tests/contrast.mjs</code>
          · notes in <code>planning/design-system.md</code>
        </p>
      </footer>
    </div>
  </div>
</BaseLayout>

<style>
  /* Specimen layout. Temporary: it leaves with the specimen. Semantic tokens only,
     except the palette chips, which show primitives on purpose. */

  .frame {
    padding: var(--space-gutter);
  }

  .shell {
    max-inline-size: var(--size-shell-max);
    margin-inline: auto;
    padding: var(--space-shell-padding);
    border: var(--border-width-hairline) solid var(--color-shell-border);
    border-radius: var(--radius-shell);
    background-color: var(--color-shell);
    box-shadow: var(--shadow-shell);
  }

  /* Masthead and colophon, on the shell */

  .masthead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-m);
    padding: var(--space-2xs) var(--space-xs) var(--space-s);
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.2rem + 0.6vw, 1.75rem);
    line-height: 1;
  }

  .wordmark-name {
    font-weight: var(--font-weight-light);
    letter-spacing: -0.01em;
  }

  .wordmark-name b {
    font-weight: var(--font-weight-bold);
  }

  .pride-mark {
    flex: none;
    inline-size: 0.625rem;
    block-size: 1.875rem;
    border-radius: 2px;
    background: linear-gradient(
      var(--color-pride-brown) 0 14.29%,
      var(--color-pride-orange) 0 28.57%,
      var(--color-pride-gold) 0 42.86%,
      var(--color-pride-tan) 0 57.14%,
      var(--color-pride-white) 0 71.43%,
      var(--color-pride-gray) 0 85.71%,
      var(--color-pride-black) 0
    );
  }

  .masthead-note,
  .colophon {
    color: var(--color-text-on-dark-muted);
    font-family: var(--font-label);
    font-size: var(--font-size-sm);
    letter-spacing: var(--letter-spacing-ui);
  }

  .masthead-note strong {
    color: var(--color-text-on-dark);
    font-weight: var(--font-weight-semibold);
  }

  .colophon {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2xs) var(--space-l);
    padding: var(--space-s) var(--space-xs) var(--space-2xs);
  }

  /* The parent folder and its sheets of paper */

  /* Single-column grids get minmax(0, 1fr) so wide content (code, formulas, long token
     names) scrolls or wraps inside its card instead of widening the page. */
  .folder,
  .type-card,
  .layer,
  .material-side,
  .env-paper,
  .mascot-text {
    grid-template-columns: minmax(0, 1fr);
  }

  .folder {
    display: grid;
    gap: var(--space-m);
    padding: var(--folder-nest-inset);
    border-radius: var(--radius-folder);
    background-color: var(--color-folder-parent);
    box-shadow: var(--shadow-folder);
  }

  .sheet {
    padding: var(--space-content-block) var(--space-content-inline);
    border-radius: var(--radius-paper);
    background-color: var(--color-folder-active);
    box-shadow: var(--shadow-paper-raised);
  }

  .sheet-head {
    display: grid;
    gap: var(--space-2xs);
    max-inline-size: var(--measure-prose);
    margin-block-end: var(--space-l);
  }

  .sheet-intro {
    color: var(--color-text-secondary);
  }

  .overline,
  .group-title,
  .type-label,
  .state-list dt {
    color: var(--color-text-secondary);
    font-family: var(--font-label);
    font-size: var(--font-size-xs);
    font-style: normal;
    font-weight: var(--font-weight-semibold);
    letter-spacing: var(--letter-spacing-label);
    line-height: var(--line-height-ui);
    text-transform: uppercase;
  }

  .group-title {
    margin-block: var(--space-xl) var(--space-s);
  }

  .muted {
    color: var(--color-text-muted);
  }

  .note {
    margin-block-start: var(--space-s);
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
  }

  /* Hero */

  .display {
    margin-block: var(--space-xs) var(--space-m);
    font-family: var(--font-display);
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-display);
    line-height: var(--line-height-display);
  }

  .display b {
    font-weight: var(--font-weight-bold);
  }

  .lead {
    max-inline-size: 38ch;
    color: var(--color-text-secondary);
    font-family: var(--font-editorial);
    font-size: var(--font-size-lead);
    font-style: italic;
    line-height: 1.45;
  }

  .hero-body {
    display: grid;
    gap: var(--space-s);
    max-inline-size: var(--measure-prose);
    margin-block-start: var(--space-l);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13.5rem), 1fr));
    gap: var(--space-m);
    margin: var(--space-xl) 0 0;
    padding: var(--space-l) 0 0;
    border-block-start: var(--border-width-hairline) solid var(--color-folder-border);
    list-style: none;
  }

  .principles li {
    display: grid;
    gap: var(--space-3xs);
    align-content: start;
  }

  .principles span:last-child {
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
  }

  .principle-mark {
    display: block;
    inline-size: 3.5rem;
    block-size: 2.25rem;
    margin-block-end: var(--space-2xs);
    border-radius: var(--radius-control);
  }

  .mark-identity {
    background: linear-gradient(
      var(--color-pride-brown) 0 14.29%,
      var(--color-pride-orange) 0 28.57%,
      var(--color-pride-gold) 0 42.86%,
      var(--color-pride-tan) 0 57.14%,
      var(--color-pride-white) 0 71.43%,
      var(--color-pride-gray) 0 85.71%,
      var(--color-pride-black) 0
    );
    box-shadow: inset 0 0 0 1px var(--color-folder-border);
  }

  /* Miniatures weave the same flannel at a smaller scale. */
  .mark-atmosphere {
    --texture-flannel-sett: 1.75rem;
    box-shadow: var(--shadow-paper);
  }

  .mark-character {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .mark-character i {
    inline-size: 1.25rem;
    block-size: 1.25rem;
    border-radius: 50%;
    background: var(--palette-navy);
  }

  .mark-character i:nth-child(2) {
    background: var(--palette-eye-green);
  }

  .mark-character i:nth-child(3) {
    background: var(--palette-honey);
  }

  .mark-character i:nth-child(4) {
    background: var(--palette-parchment);
    box-shadow: inset 0 0 0 1px var(--color-folder-border);
  }

  .mark-structure {
    padding: 0.3rem 0.3rem 0;
    background: var(--color-folder-parent);
    box-shadow: var(--shadow-folder);
  }

  .mark-structure i {
    display: block;
    block-size: 100%;
    padding: 0.25rem 0.25rem 0;
    border-radius: 2px 2px 0 0;
    background: var(--color-folder-nested);
  }

  .mark-structure i::after {
    content: "";
    display: block;
    block-size: 100%;
    border-radius: 1px 1px 0 0;
    background: var(--color-folder-active);
    box-shadow: var(--shadow-paper);
  }

  /* Specimen A: palette */

  .swatches,
  .tones,
  .pride,
  .depths,
  .bear-colors {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
    gap: var(--space-s);
  }

  .swatch {
    display: grid;
    align-content: start;
    gap: var(--space-3xs);
    overflow: hidden;
    padding-block-end: var(--space-xs);
    border: var(--border-width-hairline) solid var(--color-surface-card-border);
    border-radius: var(--radius-card);
    background-color: var(--color-surface-card);
    box-shadow: var(--shadow-paper);
  }

  .swatch-chip {
    display: block;
    block-size: 5.5rem;
    margin-block-end: var(--space-2xs);
    background: var(--chip);
    box-shadow: inset 0 -1px 0 var(--color-folder-border);
  }

  .swatch-name,
  .swatch-code,
  .swatch-role {
    padding-inline: var(--space-xs);
  }

  .swatch-name {
    font-weight: var(--font-weight-semibold);
    line-height: var(--line-height-ui);
  }

  .swatch-code {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2xs);
  }

  .swatch-code code,
  .tone-text code,
  .pride-label code,
  .layer-label code,
  .depths code,
  .role-value code {
    padding: 0;
    background: none;
    color: var(--color-text-secondary);
    font-size: var(--font-size-xs);
  }

  .swatch-role {
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    line-height: var(--line-height-ui);
  }

  .palette-split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: 0 var(--space-xl);
  }

  .pride {
    display: grid;
    overflow: hidden;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-paper);
  }

  .pride li {
    display: grid;
    grid-template-columns: 1fr minmax(9rem, 40%);
    align-items: stretch;
    background: var(--color-surface-card);
  }

  .pride li + li .pride-label {
    border-block-start: var(--border-width-hairline) solid var(--color-folder-border);
  }

  .pride-band {
    min-block-size: 2.25rem;
    background: var(--chip);
  }

  .pride-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2xs);
    padding: 0 var(--space-xs);
    font-size: var(--font-size-sm);
  }

  .tones {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
    gap: var(--space-xs) var(--space-s);
  }

  .tones li {
    display: flex;
    gap: var(--space-xs);
    align-items: center;
  }

  .tone-chip {
    flex: none;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-control);
    background: var(--chip);
    box-shadow: inset 0 0 0 1px var(--color-folder-border);
  }

  .tone-text {
    font-size: var(--font-size-sm);
    line-height: var(--line-height-ui);
  }

  .tone-text span {
    display: block;
    color: var(--color-text-muted);
  }

  .table-wrap {
    overflow-x: auto;
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-paper);
  }

  .table-wrap table {
    font-size: var(--font-size-sm);
  }

  /* Keep token names whole; on narrow screens the table scrolls inside its wrapper. */
  .role-value,
  .table-wrap td:first-child code {
    white-space: nowrap;
  }

  /* The palette table: row headings carry the token name, columns the sections. */
  .archive-color code,
  .archive th code,
  .archive-sections {
    display: block;
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-regular);
  }

  .archive-color {
    display: inline-block;
    font-size: var(--font-size-sm);
    vertical-align: top;
  }

  .role-chip {
    display: inline-block;
    inline-size: 1rem;
    block-size: 1rem;
    margin-inline-end: var(--space-2xs);
    border-radius: 3px;
    background: var(--chip);
    box-shadow: inset 0 0 0 1px var(--color-folder-border);
    vertical-align: -0.15em;
  }

  /* Specimen B: typography */

  .type-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-m);
  }

  .type-card {
    display: grid;
    align-content: start;
    gap: var(--space-s);
    margin: 0;
    padding: var(--space-m);
    border: var(--border-width-hairline) solid var(--color-surface-card-border);
    border-radius: var(--radius-card);
    background-color: var(--color-surface-card);
  }

  .type-card-wide {
    grid-column: 1 / -1;
  }

  .type-label code,
  .type-stack {
    font-size: var(--font-size-xs);
  }

  .type-label code {
    padding: 0;
    background: none;
    color: inherit;
    letter-spacing: 0;
    text-transform: none;
  }

  /* Token names wrap between tokens, never at their own hyphens. */
  .type-label code,
  .sheet-intro code {
    white-space: nowrap;
  }

  .type-stack {
    color: var(--color-text-muted);
    font-family: var(--font-code);
    overflow-wrap: anywhere;
  }

  .sample-display {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.5rem + 3.2vw, 4.25rem);
    font-weight: var(--font-weight-light);
    letter-spacing: var(--letter-spacing-display);
    line-height: var(--line-height-display);
  }

  .sample-display b {
    font-weight: var(--font-weight-bold);
  }

  .sample-heading {
    color: var(--color-text-heading);
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    font-style: var(--font-heading-style);
    font-weight: var(--font-heading-weight);
    letter-spacing: var(--letter-spacing-heading);
    line-height: var(--line-height-heading);
  }

  .sample-editorial {
    font-family: var(--font-editorial);
    font-size: 1.1875rem;
    line-height: 1.7;
  }

  .sample-small {
    font-size: var(--font-size-sm);
  }

  .type-card-code pre {
    margin: 0;
  }

  .sample-math {
    font-size: clamp(1.0625rem, 0.9rem + 1vw, 1.375rem);
  }

  .type-card blockquote p {
    font-size: 1.125rem;
  }

  .tab-labels {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: var(--space-s) var(--space-m);
    margin: 0;
  }

  .tab-labels dt {
    color: var(--color-text-muted);
    font-size: var(--font-size-xs);
  }

  .tab-labels dd {
    font-family: var(--font-label);
    font-weight: var(--font-weight-tab);
    letter-spacing: var(--letter-spacing-tab);
  }

  .tab-label-1 {
    font-size: var(--font-size-tab-1);
  }

  .tab-label-2 {
    font-size: var(--font-size-tab-2);
  }

  .tab-label-3 {
    font-size: var(--font-size-tab-3);
  }

  .tab-label-preview {
    color: var(--color-text-secondary);
    font-size: var(--font-size-tab-preview);
    font-weight: var(--font-weight-regular);
  }

  /* Specimen C: materials */

  .materials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 24rem), 1fr));
    gap: var(--space-xl);
    align-items: start;
  }

  .stack {
    margin: 0;
  }

  .layer {
    display: grid;
    gap: var(--space-s);
    padding: var(--space-s);
  }

  .layer-shell {
    border: var(--border-width-hairline) solid var(--color-shell-border);
    border-radius: var(--radius-shell);
    background-color: var(--color-shell);
    box-shadow: var(--shadow-shell);
  }

  .layer-parent {
    border-radius: var(--radius-folder);
    background-color: var(--color-folder-parent);
    box-shadow: var(--shadow-folder);
  }

  .layer-nested {
    border-radius: var(--radius-card);
    background-color: var(--color-folder-nested);
    box-shadow: var(--shadow-paper), var(--shadow-recess);
  }

  .layer-active {
    min-block-size: 7rem;
    border-radius: var(--radius-paper);
    background-color: var(--color-folder-active);
    box-shadow: var(--shadow-paper-raised);
  }

  .layer-label {
    display: grid;
    gap: 0.125rem;
    font-size: var(--font-size-sm);
    line-height: var(--line-height-ui);
  }

  .layer-label span {
    color: var(--color-text-secondary);
  }

  .layer-label.gl-on-dark code {
    color: var(--color-text-on-dark-muted);
  }

  .material-side {
    display: grid;
    gap: var(--space-l);
  }

