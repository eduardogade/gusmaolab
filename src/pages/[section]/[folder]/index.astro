---
// Level-2 pages (P06, P10): the registered folders at this depth (such as /cv/research/) and the entries at /<section>/<slug>/ (Blog), generated from
// data. Only registered folders and entries that are published or archived get a page;
// any other URL has none.
import FolderPage from "../../../layouts/FolderPage.astro"
import DestinationPage from "../../../components/states/DestinationPage.astro"
import { coverageFor, siteCoverage } from "../../../site/page.ts"
import EditorialEntry from "../../../components/editorial/EditorialEntry.astro"
import CollectionOverview from "../../../components/editorial/CollectionOverview.astro"
import { DESTINATIONS } from "../../../site/destinations.ts"
import { collectionIndexFor, pageStaticPaths } from "../../../editorial/site.ts"

export function getStaticPaths() {
  return pageStaticPaths(2)
}

const { collection, entry } = Astro.props
const index = entry === undefined ? await collectionIndexFor(Astro.url.pathname) : null
const row = entry === undefined ? await coverageFor(Astro.url.pathname) : undefined
const rows = row !== undefined && index === null ? await siteCoverage() : []
---

{
  collection !== undefined && entry !== undefined ? (
    <FolderPage description={entry.data.description}>
      <EditorialEntry collection={collection} entry={entry} />
    </FolderPage>
  ) : (
    <FolderPage description={index ? index.identity : row === undefined ? undefined : DESTINATIONS[row.id]?.intro}>
      {index ? (
        <div data-page-root data-page-state={row?.state}>
          <CollectionOverview
            collection={index.id}
            label={index.label}
            identity={index.identity}
            items={index.items}
            demoItems={index.demoItems}
          />
        </div>
      ) : (
        row !== undefined && <DestinationPage row={row} rows={rows} />
      )}
    </FolderPage>
  )
}
