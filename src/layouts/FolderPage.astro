---
/**
 * A site page inside the physical folders (P06). It reads the page's own URL, resolves
 * the folder state from the navigation registry, sets the section environment, and draws
 * the folders with the page's content on paper inside the deepest open folder.
 *
 *   <FolderPage>…the page's content…</FolderPage>
 *
 * A page supplies only its content: the URL decides which folders surround it, so no page
 * builds its own rows of tabs. A URL the registry does not know fails the build.
 *
 * Landmarks: each row of tabs is a navigation landmark ("Sections", "CV folders"), and
 * `<main>` is the content inside the deepest folder, after every row.
 */
import BaseLayout from "./BaseLayout.astro"
import FolderStack from "../components/folders/FolderStack.astro"
import { siteNavigation } from "../navigation/index.ts"
// A short cross-fade between folder pages, where the browser supports it (P09).
import "../styles/view-transitions.css"

interface Props {
  /** The document title. Default: the open folders, deepest first, then "GusmaoLab". */
  title?: string
  description?: string
}

const result = siteNavigation.resolve(Astro.url.pathname)
if (!result.found) {
  throw new Error(`FolderPage: ${result.path} is not a registered page`)
}
const { state } = result
// "core" is the default environment: no attribute.
const environment = state.environment === "core" ? undefined : state.environment
const routeTitle = state.page.kind === "content" ? state.page.route.title : undefined
const folders = [...state.selection].reverse().map((node) => node.label)
const title =
  Astro.props.title ??
  (routeTitle !== undefined
    ? `${routeTitle} · GusmaoLab`
    : state.path === "/"
      ? "GusmaoLab"
      : `${folders.join(" · ")} · GusmaoLab`)
---

<BaseLayout
  title={title}
  description={Astro.props.description}
  environment={environment}
  main={false}
>
  <div class="page" data-page-path={state.path}>
    <div class="page-shell">
      <FolderStack state={state}>
        <main id="content">
          <slot />
        </main>
      </FolderStack>
    </div>
  </div>
</BaseLayout>

<style>
  /* The cabinet: a dark shell on the flannel, holding the folders. */
  .page {
    max-inline-size: var(--size-shell-max);
    margin-inline: auto;
    padding: var(--space-gutter);
  }

  .page-shell {
    padding: var(--space-shell-padding);
    border: var(--border-width-hairline) solid var(--color-shell-border);
    border-radius: var(--radius-shell);
    background-color: var(--color-shell);
    box-shadow: var(--shadow-shell);
  }
</style>
