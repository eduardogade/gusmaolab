---
/**
 * A site page inside the physical folders (P06). It reads the page's own URL, resolves
 * the folder state from the navigation registry, sets the open section's archive category
 * (colour, P09-A01) and environment (typography), and draws the folders with the page's
 * content on paper inside the deepest open folder.
 *
 *   <FolderPage>…the page's content…</FolderPage>
 *
 * A page supplies only its content: the URL decides which folders surround it, so no page
 * builds its own rows of tabs. A URL the registry and the editorial entries do not know
 * fails the build.
 *
 * Landmarks: each row of tabs is a navigation landmark ("Sections", "CV folders"), and
 * `<main>` is the content inside the deepest folder, after every row.
 */
import BaseLayout from "./BaseLayout.astro"
import FolderStack from "../components/folders/FolderStack.astro"
import { getSiteNavigation } from "../editorial/site.ts"
// A short cross-fade between folder pages, where the browser supports it (P09).
import "../styles/view-transitions.css"
// The editorial reading styles (P12): on every folder page, so that all pages share one
// stylesheet set (RESP-013). Its classes are used only by editorial components.
import "../styles/editorial.css"

interface Props {
  /** The document title. Default: the open folders, deepest first, then "GusmaoLab". */
  title?: string
  description?: string
  /**
   * Draw the folders of this registered URL instead of the page's own. Only the design
   * studies use it, to show content inside the folders it would live in while the study
   * itself is not a registered page (P12, D-097).
   */
  path?: string
}

// The folders plus the entries' pages (P10): an entry resolves to its owning folder.
const result = (await getSiteNavigation()).resolve(
  Astro.props.path ?? Astro.url.pathname,
)
if (!result.found) {
  throw new Error(`FolderPage: ${result.path} is not a registered page`)
}
const { state } = result
// "core" is the default environment: no attribute.
const environment = state.environment === "core" ? undefined : state.environment
const routeTitle = state.page.kind === "content" ? state.page.route.title : undefined
const folders = [...state.selection].reverse().map((node) => node.label)
const title =
  Astro.props.title ??
  (routeTitle !== undefined
    ? `${routeTitle} · GusmaoLab`
    : state.path === "/"
      ? "GusmaoLab"
      : `${folders.join(" · ")} · GusmaoLab`)
---

<BaseLayout
  title={title}
  description={Astro.props.description}
  category={state.category}
  environment={environment}
  main={false}
>
  <div class="page" data-page-path={state.path}>
    <div class="page-shell">
      <FolderStack state={state}>
        <main id="content" tabindex="-1">
          <slot />
        </main>
      </FolderStack>
    </div>
  </div>
</BaseLayout>

<style>
  /* The cabinet: a dark shell on the flannel, holding the folders. The same in every
     category. */
  .page {
    max-inline-size: var(--size-shell-max);
    margin-inline: auto;
    padding: var(--space-gutter);
  }

  .page-shell {
    padding: var(--space-shell-padding);
    border: var(--border-width-hairline) solid var(--color-shell-border);
    border-radius: var(--radius-shell);
    background-color: var(--color-shell);
    box-shadow: var(--shadow-shell);
  }
</style>
