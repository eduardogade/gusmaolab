---
// Order matters: primitives and semantic tokens, then the section environments
// (typography and texture), then the category palettes (colour), then the global
// foundation that consumes them.
import "../styles/tokens.css"
import "../styles/environments.css"
import "../styles/categories.css"
import "../styles/global.css"
// The homepage (P15): global like the other styles, so that every page loads one stylesheet set (RESP-013).
import "../styles/home.css"
// The content states, folder guides and related links (P17): global too, for the same reason.
import "../styles/states.css"
import type { ArchiveCategory, SectionEnvironment } from "../navigation/index.ts"

interface Props {
  title: string
  description?: string
  /**
   * The page's archive category, from src/styles/categories.css: its flannel, folder
   * bodies and reading paper. Default: Core. Top-level tabs keep their own category
   * whatever this is.
   */
  category?: ArchiveCategory
  /**
   * Section environment from src/styles/environments.css: typography and texture, never
   * colour. Omit for the core environment.
   */
  environment?: Exclude<SectionEnvironment, "core">
  /**
   * Wrap the page in `<main>`. Folder pages pass false and place `<main>` inside the
   * deepest folder, after the rows of tabs (FolderPage, P06).
   */
  main?: boolean
}

const { title, description, category = "core", environment, main = true } = Astro.props
---

<!doctype html>
<html lang="en" data-category={category} data-environment={environment}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="gl-flannel">
    {
      /* Bypass block (P23, D-161, WCAG 2.4.1): the folder rows hold about forty links before any content, because a
         folder's preview lists its children and those links are in the tab order. The first Tab stop skips them.
         Hidden until it has focus. Every folder page and the error page have `<main id="content" tabindex="-1">`: the target
         must be able to take focus, or Firefox leaves focus on the link and the next Tab returns to the first folder tab
         (found by the P23 close-out review, D-162). */
    }
    <a class="gl-skip-link" href="#content">Skip to main content</a>
    {
      main ? (
        <main id="content" tabindex="-1">
          <slot />
        </main>
      ) : (
        <slot />
      )
    }
  </body>
</html>
