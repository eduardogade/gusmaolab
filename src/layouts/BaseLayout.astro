---
// Order matters: primitives and semantic tokens, then environment overrides, then the
// global foundation that consumes them.
import "../styles/tokens.css"
import "../styles/environments.css"
import "../styles/global.css"
import type { SectionEnvironment } from "../navigation/index.ts"

interface Props {
  title: string
  description?: string
  /** Section environment from src/styles/environments.css. Omit for the core environment. */
  environment?: Exclude<SectionEnvironment, "core">
  /**
   * Wrap the page in `<main>`. Folder pages pass false and place `<main>` inside the
   * deepest folder, after the rows of tabs (FolderPage, P06).
   */
  main?: boolean
}

const { title, description, environment, main = true } = Astro.props
---

<!doctype html>
<html lang="en" data-environment={environment}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
  </head>
  <body class="gl-flannel">
    {
      main ? (
        <main>
          <slot />
        </main>
      ) : (
        <slot />
      )
    }
  </body>
</html>
